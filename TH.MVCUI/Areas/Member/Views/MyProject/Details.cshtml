@model TH.MVCUI.Areas.Member.Models.PageVMs.MyProjectVM.MyProjectDetailsVm

@{
    ViewData["Title"] = "Project Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>@Model.ProjectName</h1>

        <p>

            View project information and assigned team members.

        </p>

    </div>

    <a asp-action="Index"
       class="btn-outline-custom">

        <i class="fa-solid fa-arrow-left"></i>

        Back

    </a>

</div>

<div class="dashboard-grid">

    <div>

        <div class="dashboard-card">

            <h3>

                <i class="fa-solid fa-folder-open text-primary"></i>

                Project Information

            </h3>

            <hr />

            <h5>

                Description

            </h5>

            <p class="text-muted">

                @Model.Description

            </p>

        </div>

        <br />

        <div class="dashboard-card">

            <h3>

                <i class="fa-solid fa-list-check text-success"></i>

                Project Tasks

            </h3>

            <hr />

            @if (Model.Tasks.Any())
            {
                foreach (var task in Model.Tasks)
                {
                    <div class="project-item">

                        <div class="project-left">

                            <div class="project-icon">

                                @if (task.IsCompleted)
                                {
                                    <i class="fa-solid fa-circle-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-clock text-warning"></i>
                                }

                            </div>

                            <div>

                                <div class="project-name">

                                    @task.Title

                                </div>

                                <div class="project-date">

                                    Priority :
                                    @task.Priority

                                </div>

                            </div>

                        </div>

                        <div>

                            @if (task.IsCompleted)
                            {
                                <span class="status-badge completed">

                                    Completed

                                </span>
                            }
                            else
                            {
                                <span class="status-badge pending">

                                    Pending

                                </span>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <p class="text-muted">

                    No task assigned.

                </p>
            }

        </div>

    </div>

    <div>

        <div class="dashboard-card">

            <h3>

                <i class="fa-solid fa-users text-primary"></i>

                Team Members

            </h3>

            <hr />

            @if (Model.Users.Any())
            {
                foreach (var user in Model.Users)
                {
                    <div class="activity">

                        <div class="activity-avatar">

                            @user.FirstName.Substring(0, 1).ToUpper()

                        </div>

                        <div class="activity-content">

                            <h5>

                                @user.FirstName @user.LastName

                            </h5>

                            <p>

                                @user.Email

                            </p>

                        </div>

                    </div>
                }
            }
            else
            {
                <p class="text-muted">

                    No members assigned.

                </p>
            }

        </div>

    </div>

</div>