@model List<TH.MVCUI.Areas.Member.Models.PageVMs.MyProjectVM.MyProjectListVm>

<div class="row g-4">

    @foreach (var project in Model)
    {
        <div class="col-xl-4 col-lg-6">

            <div class="dashboard-card project-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="project-icon">

                            <i class="fa-solid fa-folder-open"></i>

                        </div>

                        <h3 class="mt-3">

                            @project.ProjectName

                        </h3>

                        <p class="text-muted">

                            @project.Description

                        </p>

                    </div>

                    @if (project.Status == TH.ENTITIES.Enums.DataStatus.Deleted)
                    {
                        <span class="badge bg-danger">

                            Passive

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">

                            Active

                        </span>
                    }

                </div>

                <hr />

                <div class="row text-center">

                    <div class="col-6">

                        <small class="text-muted">

                            Members

                        </small>

                        <h5>

                            @project.UserCount

                        </h5>

                    </div>

                    <div class="col-6">

                        <small class="text-muted">

                            Tasks

                        </small>

                        <h5>

                            @project.TaskCount

                        </h5>

                    </div>

                </div>

                <hr />

                <div class="d-grid">

                    <a asp-action="Details"
                       asp-route-id="@project.Id"
                       class="btn-primary-custom">

                        <i class="fa-solid fa-eye"></i>

                        View Project

                    </a>

                </div>

            </div>

        </div>
    }

</div>