<div class="dashboard-card">

    <h3 class="mb-4">

        Quick Actions

    </h3>

    <div class="quick-actions">

        <a asp-area="Member"
           asp-controller="MyProject"
           asp-action="Index"
           class="quick-action blue">

            <i class="fa-solid fa-folder"></i>

            <span>My Projects</span>

        </a>

        <a asp-area="Member"
           asp-controller="MyTask"
           asp-action="Index"
           class="quick-action teal">

            <i class="fa-solid fa-list-check"></i>

            <span>My Tasks</span>

        </a>

        <a asp-area="Member"
           asp-controller="Notification"
           asp-action="Index"
           class="quick-action orange">

            <i class="fa-solid fa-bell"></i>

            <span>Notifications</span>

        </a>

        <a asp-area="Member"
           asp-controller="Profile"
           asp-action="Index"
           class="quick-action purple">

            <i class="fa-solid fa-user"></i>

            <span>Profile</span>

        </a>

    </div>

</div>