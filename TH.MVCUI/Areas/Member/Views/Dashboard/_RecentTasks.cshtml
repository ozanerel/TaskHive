@model TH.MVCUI.Areas.Member.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>

            <i class="fa-solid fa-list-check text-success"></i>

            My Recent Tasks

        </h3>

        <a asp-area="Member"
           asp-controller="Task"
           asp-action="Index"
           class="btn-outline-custom">

            View All

        </a>

    </div>

    @if (Model.RecentTasks != null && Model.RecentTasks.Any())
    {
        foreach (var task in Model.RecentTasks)
        {
            <div class="project-item">

                <div class="project-left">

                    <div class="project-icon">

                        @if (task.IsCompleted)
                        {
                            <i class="fa-solid fa-circle-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-clock text-warning"></i>
                        }

                    </div>

                    <div>

                        <div class="project-name">

                            @task.Title

                        </div>

                        <div class="project-date">

                            @task.Project?.ProjectName

                        </div>

                    </div>

                </div>

                <div class="text-end">

                    @if (task.IsCompleted)
                    {
                        <span class="status-badge completed">

                            Completed

                        </span>
                    }
                    else
                    {
                        <span class="status-badge pending">

                            Pending

                        </span>
                    }

                    <br />

                    <small class="text-muted">

                        @task.CreatedDate.ToString("dd MMM yyyy")

                    </small>

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-list-check fa-3x text-secondary mb-3"></i>

            <h5>

                No Task Found

            </h5>

            <p class="text-muted">

                You don't have any assigned tasks yet.

            </p>

        </div>
    }

</div>