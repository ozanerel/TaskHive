@model TH.MVCUI.Areas.Member.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>

            <i class="fa-solid fa-clock-rotate-left text-primary"></i>

            My Activity

        </h3>

    </div>

    @if (Model.RecentTasks != null && Model.RecentTasks.Any())
    {
        foreach (var task in Model.RecentTasks)
        {
            <div class="activity">

                <div class="activity-avatar">

                    @task.Title.Substring(0, 1).ToUpper()

                </div>

                <div class="activity-content">

                    <h5>

                        @task.Title

                    </h5>

                    @if (task.IsCompleted)
                    {
                        <p>

                            Task completed successfully.

                        </p>
                    }
                    else
                    {
                        <p>

                            Task is currently in progress.

                        </p>
                    }

                    <small class="text-muted">

                        @task.CreatedDate.ToString("dd MMM yyyy")

                    </small>

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-clock fa-3x text-secondary mb-3"></i>

            <h5>

                No Activity Yet

            </h5>

            <p class="text-muted">

                Your recent activities will appear here.

            </p>

        </div>
    }

</div>