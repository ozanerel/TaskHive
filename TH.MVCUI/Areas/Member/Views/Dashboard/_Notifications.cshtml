@model TH.MVCUI.Areas.Member.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>

            My Notifications

            @if (Model.UnreadNotificationCount > 0)
            {
                <span class="badge bg-danger ms-2">
                    @Model.UnreadNotificationCount
                </span>
            }

        </h3>

        <a asp-area="Member"
           asp-controller="Notification"
           asp-action="Index"
           class="btn-outline-custom">

            View All

        </a>

    </div>

    @if (Model.RecentNotifications.Any())
    {
        foreach (var notification in Model.RecentNotifications)
        {
            <div class="notification-item">

                <div class="notification-icon">

                    @if (notification.IsRead)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-bell"></i>
                    }

                </div>

                <div class="notification-content">

                    <h5>@notification.Title</h5>

                    <p>@notification.Message</p>

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-4">

            <i class="fa-solid fa-bell-slash fa-3x"></i>

            <h5>No Notifications</h5>

        </div>
    }

</div>