@model TH.MVCUI.Models.ViewModels.SearchVm

@{
    ViewData["Title"] = "Search";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Search Results</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <p>
                Results for
                "<strong>@Model.Keyword</strong>"
                -
                <strong>@Model.TotalResultCount</strong>
                results found.
            </p>
        }
        else
        {
            <p>
                Search projects, tasks and users.
            </p>
        }

    </div>

</div>


@if (!string.IsNullOrWhiteSpace(Model.Keyword) &&
   !Model.Projects.Any() &&
   !Model.Tasks.Any() &&
   !Model.Users.Any())
{
    <div class="dashboard-card text-center py-5">

        <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>

        <h4>No results found</h4>

        <p class="text-muted">
            Try another keyword.
        </p>

    </div>
}
else
{
    <!-- PROJECTS -->
    @if (Model.Projects.Any())
    {
        <div class="search-section mb-4">

            <h4>Projects</h4>

            <div class="dashboard-card">

                <div class="table-responsive">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Project Name</th>
                                <th>Description</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.Projects)
                            {
                                <tr>

                                    <td>
                                        @item.ProjectName
                                    </td>

                                    <td>
                                        @item.Description
                                    </td>

                                    <td>

                                        <a asp-area="Member"
                                           asp-controller="MyProject"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary">

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }


    <!-- TASKS -->
    @if (Model.Tasks.Any())
    {
        <div class="search-section mb-4">

            <h4>Tasks</h4>

            <div class="dashboard-card">

                <div class="table-responsive">

                    <table class="table">

                        <thead>

                            <tr>
                                <th>Task</th>
                                <th>Priority</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Tasks)
                            {
                                <tr>

                                    <td>
                                        @item.Title
                                    </td>

                                    <td>
                                        @item.Priority
                                    </td>

                                    <td>

                                        <a asp-area="Member"
                                           asp-controller="MyTask"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary">

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }


    <!-- USERS -->
    @if (Model.Users.Any())
    {
        <div class="search-section mb-4">

            <h4>Users</h4>

            <div class="dashboard-card">

                <div class="table-responsive">

                    <table class="table">

                        <thead>

                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Users)
                            {
                                <tr>

                                    <td>
                                        @item.FirstName
                                        @item.LastName
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
}