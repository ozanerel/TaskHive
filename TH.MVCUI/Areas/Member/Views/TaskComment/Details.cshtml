@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskCommentVM.TaskCommentDetailsVm

@{
    ViewData["Title"] = "Comment Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Comment Details</h1>

        <p>

            View complete information about this comment.

        </p>

    </div>

</div>

<div class="dashboard-card">

    <div class="row g-4">

        <div class="col-md-6">

            <label class="text-muted">

                Task

            </label>

            <h5>

                @Model.Comment.Task?.Title

            </h5>

        </div>

        <div class="col-md-6">

            <label class="text-muted">

                User

            </label>

            <h5>

                @Model.Comment.User?.FirstName
                @Model.Comment.User?.LastName

            </h5>

        </div>

        <div class="col-12">

            <label class="text-muted">

                Comment

            </label>

            <div class="border rounded p-3 mt-2">

                @Model.Comment.Message

            </div>

        </div>

        <div class="col-md-6">

            <label class="text-muted">

                Status

            </label>

            <br />

            @if (Model.Comment.IsRead)
            {
                <span class="status-badge completed">

                    Read

                </span>
            }
            else
            {
                <span class="status-badge pending">

                    Unread

                </span>
            }

        </div>

        <div class="col-md-6">

            <label class="text-muted">

                Created Date

            </label>

            <h6>

                @Model.Comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")

            </h6>

        </div>

    </div>

    <hr />

    <div class="d-flex justify-content-end gap-3">

        <a asp-action="Edit"
           asp-route-id="@Model.Comment.Id"
           class="btn-warning">

            <i class="fa-solid fa-pen"></i>

            Edit

        </a>

        <a asp-action="Index"
           class="btn-outline-custom">

            Back

        </a>

    </div>

</div>