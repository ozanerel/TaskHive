@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskCommentVM.TaskCommentDetailsVm

<div class="container mt-4">

    <div class="card">

        <div class="card-header bg-info text-white">

            <h3>Comment Detail</h3>

        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-3">
                    Id
                </dt>

                <dd class="col-9">
                    @Model.Comment.Id
                </dd>

                <dt class="col-3">
                    Message
                </dt>

                <dd class="col-9">
                    @Model.Comment.Message
                </dd>

                <dt class="col-3">
                    Task
                </dt>

                <dd class="col-9">
                    @Model.Comment.Task?.Title
                </dd>

                <dt class="col-3">
                    User
                </dt>

                <dd class="col-9">
                    @Model.Comment.User?.FirstName
                    @Model.Comment.User?.LastName
                </dd>

                <dt class="col-3">
                    Status
                </dt>

                <dd class="col-9">

                    @if (Model.Comment.IsRead)
                    {
                        <span class="badge bg-success">
                            Read
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning">
                            Unread
                        </span>
                    }

                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.Comment.Id"
               class="btn btn-warning">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

</div>