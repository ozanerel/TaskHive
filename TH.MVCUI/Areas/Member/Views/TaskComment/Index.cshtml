@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskCommentVM.TaskCommentIndexVm

@{
    ViewData["Title"] = "Task Comments";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Task Comments</h1>

        <p>
            Manage comments for your tasks.
        </p>

    </div>

    <a asp-action="Create"
       class="btn-primary-custom">

        <i class="fa-solid fa-plus"></i>

        New Comment

    </a>

</div>

@await Html.PartialAsync("_CommentCards", Model)