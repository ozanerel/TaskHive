@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskCommentVM.TaskCommentCreateVm

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Comment";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Create Comment</h1>

        <p>

            Add a new comment to a task.

        </p>

    </div>

</div>

<div class="dashboard-card">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-4">

            <label asp-for="Message"
                   class="form-label">

                Comment

            </label>

            <textarea asp-for="Message"
                      rows="5"
                      class="form-control">
            </textarea>

            <span asp-validation-for="Message"
                  class="text-danger">
            </span>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label class="form-label">

                        Task

                    </label>

                    <select asp-for="TaskId"
                            asp-items="@(new SelectList(ViewBag.Tasks,"Id","Title"))"
                            class="form-select">

                        <option value="">

                            Select Task

                        </option>

                    </select>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-4">

                    <label class="form-label">

                        User

                    </label>

                    <select asp-for="UserId"
                            asp-items="@(new SelectList(ViewBag.Users,"Id","FirstName"))"
                            class="form-select">

                        <option value="">

                            Select User

                        </option>

                    </select>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-3">

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Comment

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}