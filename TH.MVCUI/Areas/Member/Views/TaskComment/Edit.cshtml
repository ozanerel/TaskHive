@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskCommentVM.TaskCommentUpdateVm

@using Microsoft.AspNetCore.Mvc.Rendering

<div class="container mt-4">

    <div class="card">

        <div class="card-header bg-warning">

            <h3>Edit Comment</h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input asp-for="Id" hidden />

                <div class="mb-3">

                    <label asp-for="Message"></label>

                    <textarea asp-for="Message"
                              class="form-control"
                              rows="5"></textarea>

                </div>

                <div class="mb-3">

                    <label>Task</label>

                    <select asp-for="TaskId"
                            asp-items="@(new SelectList(ViewBag.Tasks,"Id","Title"))"
                            class="form-control"></select>

                </div>

                <div class="mb-3">

                    <label>User</label>

                    <select asp-for="UserId"
                            asp-items="@(new SelectList(ViewBag.Users,"Id","FirstName"))"
                            class="form-control"></select>

                </div>

                <div class="form-check mb-3">

                    <input asp-for="IsRead"
                           class="form-check-input" />

                    <label asp-for="IsRead"
                           class="form-check-label">

                        Mark As Read

                    </label>

                </div>

                <button class="btn btn-primary">

                    Save

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}