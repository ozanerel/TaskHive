@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskCommentVM.TaskCommentDeleteVm

@{
    ViewData["Title"] = "Delete Comment";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Delete Comment</h1>

        <p>This action cannot be undone.</p>

    </div>

</div>

<div class="dashboard-card">

    <div class="alert alert-danger">

        <i class="fa-solid fa-triangle-exclamation me-2"></i>

        Are you sure you want to delete this comment?

    </div>

    <div class="mb-4">

        <label class="text-muted">

            Task

        </label>

        <h5>

            @Model.Comment.Task?.Title

        </h5>

    </div>

    <div class="mb-4">

        <label class="text-muted">

            User

        </label>

        <h5>

            @Model.Comment.User?.FirstName
            @Model.Comment.User?.LastName

        </h5>

    </div>

    <div class="mb-4">

        <label class="text-muted">

            Comment

        </label>

        <div class="border rounded p-3 mt-2">

            @Model.Comment.Message

        </div>

    </div>

    <form asp-action="Delete"
          method="post">

		@Html.AntiForgeryToken()

        <input asp-for="Comment.Id"
               type="hidden" />

        <div class="d-flex justify-content-end gap-3">

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

            <button class="btn-danger">

                <i class="fa-solid fa-trash"></i>

                Delete

            </button>

        </div>

    </form>

</div>