@model TH.MVCUI.Areas.Member.Models.PageVMs.TaskVM.TaskDetailPageVm

@{
    ViewData["Title"] = "Task Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Task Details</h1>

        <p>

            View task information.

        </p>

    </div>

</div>

<div class="dashboard-card">

    <h3>

        @Model.Task.Title

    </h3>

    <hr />

    <div class="row">

        <div class="col-md-6">

            <p>

                <strong>Description</strong>

            </p>

            <p>

                @Model.Task.Description

            </p>

        </div>

        <div class="col-md-6">

            <p>

                <strong>Priority</strong>

            </p>

            <span class="status-badge">

                @Model.Task.Priority

            </span>

            <br /><br />

            <p>

                <strong>Status</strong>

            </p>

            @if (Model.Task.Status ==
            TH.ENTITIES.Enums.DataStatus.Deleted)
            {
                <span class="badge bg-danger">

                    Passive

                </span>
            }
            else if (Model.Task.IsCompleted)
            {
                <span class="badge bg-success">

                    Completed

                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">

                    Waiting

                </span>
            }

            <br /><br />

            <p>

                <strong>Due Date</strong>

            </p>

            <p>

                @(Model.Task.DueDate?
                    .ToString("dd.MM.yyyy")
                    ?? "No due date")

            </p>

            <p>

                <strong>Completed Date</strong>

            </p>

            <p>

                @(Model.Task.CompletedDate?
                    .ToString("dd.MM.yyyy HH:mm")
                    ?? "Not completed")

            </p>

        </div>

    </div>

    <hr />

    <p>

        <strong>Project</strong>

    </p>

    <p>

        @Model.Task.Project?.ProjectName

    </p>

    <p>

        <strong>Required Role</strong>

    </p>

    <p>

        @(Model.Task.RequiredRole?.Name
            ?? "No Required Role")

    </p>

    <div class="text-end">

        <a asp-action="Index"
           class="btn-outline-custom">

            Back

        </a>

        @if (Model.Task.Status !=
        TH.ENTITIES.Enums.DataStatus.Deleted)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Task.Id"
               class="btn-primary-custom">

                <i class="fa-solid fa-pen"></i>

                Edit

            </a>
        }

    </div>

</div>