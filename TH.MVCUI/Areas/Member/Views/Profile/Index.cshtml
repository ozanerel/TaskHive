@model TH.MVCUI.Areas.Member.Models.PageVMs.ProfileVM.ProfileVm

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">
        <h1>My Profile</h1>
        <p>View your personal information.</p>
    </div>

   @*  <a asp-action="Edit"
       class="btn-primary-custom">

        <i class="fa-solid fa-user-pen"></i>

        Edit Profile

    </a> *@

    <a asp-action="Edit"
       asp-controller="Profile"
       asp-area="Member"
       class="btn-edit-profile">

        <i class="fa-solid fa-user-pen"></i>
        Edit Profile

    </a>

</div>

<div class="dashboard-card profile-card">

    <div class="row">

        <div class="col-lg-3 text-center">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     class="profile-avatar"
                     alt="Profile Photo" />
            }
            else
            {
                <img src="~/images/default-user.png"
                     class="profile-avatar"
                     alt="Profile Photo" />
            }

            <h4 class="mt-3">
                @Model.FirstName @Model.LastName
            </h4>

            <span class="status-badge">
                @Model.RoleName
            </span>

        </div>

        <div class="col-lg-9">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="text-muted">
                        First Name
                    </label>

                    <h5>@Model.FirstName</h5>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        Last Name
                    </label>

                    <h5>@Model.LastName</h5>

                </div>

                <div class="col-md-12">

                    <label class="text-muted">
                        Email Address
                    </label>

                    <h5>@Model.Email</h5>

                </div>

                <div class="col-md-12">

                    <label class="text-muted">
                        Role
                    </label>

                    <h5>@Model.RoleName</h5>

                </div>

            </div>

        </div>

    </div>

</div>