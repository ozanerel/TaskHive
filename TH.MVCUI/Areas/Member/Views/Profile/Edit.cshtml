@model TH.MVCUI.Areas.Member.ViewModels.ProfileVM.EditProfileVm

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Edit Profile</h1>

        <p>Update your personal information.</p>

    </div>

</div>

<div class="dashboard-card">

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="profile-form">

        <input asp-for="Id" hidden />

        <input asp-for="ImageUrl" hidden />

        <div class="text-center mb-4">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     class="profile-avatar" />
            }
            else
            {
                <img src="~/images/default-user.png"
                     class="profile-avatar" />
            }

        </div>

        <div class="mb-4">

            <label class="form-label">

                Profile Photo

            </label>

            <input asp-for="ImageFile"
                   class="form-control"
                   type="file" />

            <small class="text-muted">

                Allowed formats:
                JPG, JPEG, PNG, WEBP

                <br />

                Maximum size:
                2 MB

            </small>

            <span asp-validation-for="ImageFile" class="text-danger"></span>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="FirstName"
                           class="form-label"></label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="LastName"
                           class="form-label"></label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>

                </div>

            </div>

        </div>

        <div class="mb-4">

            <label asp-for="Email"
                   class="form-label"></label>

            <input asp-for="Email"
                   class="form-control" />

            <span asp-validation-for="Email"
                  class="text-danger"></span>

        </div>

        <div class="d-flex justify-content-end gap-3">

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Changes

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}