@model TH.MVCUI.Areas.Member.ViewModels.ProfileVM.EditProfileVm

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Edit Profile</h1>

        <p>

            Update your personal information.

        </p>

    </div>

</div>

<div class="dashboard-card">

    <form asp-action="Edit"
          method="post"
          class="profile-form">

        <input asp-for="Id"
               type="hidden" />

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="FirstName"
                           class="form-label">

                        First Name

                    </label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="LastName"
                           class="form-label">

                        Last Name

                    </label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>

                </div>

            </div>

        </div>

        <div class="mb-4">

            <label asp-for="Email"
                   class="form-label">

                Email Address

            </label>

            <input asp-for="Email"
                   class="form-control" />

            <span asp-validation-for="Email"
                  class="text-danger"></span>

        </div>

        <div class="d-flex justify-content-end gap-3">

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Changes

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}