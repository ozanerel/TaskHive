@model TH.MVCUI.Areas.Member.Models.PageVMs.NotificationPageVm

<div class="row g-4">

    @foreach (var notification in Model.Notifications)
    {
        <div class="col-xl-4 col-lg-6">

            <div class="dashboard-card notification-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="notification-icon">

                            @if (notification.IsRead)
                            {
                                <i class="fa-solid fa-envelope-open"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-envelope"></i>
                            }

                        </div>

                        <h3 class="mt-3">

                            @notification.Title

                        </h3>

                        <p class="text-muted">

                            @(notification.Message.Length > 80
                                ? notification.Message.Substring(0, 80) + "..."
                                : notification.Message)

                        </p>

                    </div>

                    @if (notification.IsRead)
                    {
                        <span class="badge bg-success">

                            Read

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">

                            Unread

                        </span>
                    }

                </div>

                <hr />

                <div class="row text-center">

                    <div class="col-12">

                        <small class="text-muted">

                            Date

                        </small>

                        <h6>

                            @notification.NotificationDate.ToString("dd.MM.yyyy HH:mm")

                        </h6>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Details"
                       asp-route-id="@notification.Id"
                       class="btn-outline-custom">

                        <i class="fa-solid fa-eye"></i>

                    </a>

                    @if (!notification.IsRead)
                    {
                        <a asp-action="MarkAsRead"
                           asp-route-id="@notification.Id"
                           class="btn-primary-custom">

                            <i class="fa-solid fa-check"></i>

                        </a>
                    }
                    else
                    {
                        <button class="btn btn-success" disabled>

                            <i class="fa-solid fa-check"></i>

                        </button>
                    }

                </div>

            </div>

        </div>
    }

</div>