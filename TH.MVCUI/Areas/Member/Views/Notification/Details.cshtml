@model TH.MVCUI.Areas.Member.Models.PageVMs.NotificationVM.NotificationDetailsVm

@{
    ViewData["Title"] = "Notification Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Notification Details</h1>

        <p>

            View notification information.

        </p>

    </div>

</div>

<div class="dashboard-card notification-detail-card">

    <div class="d-flex justify-content-between align-items-center">

        <h2>

            @Model.Title

        </h2>

        @if (Model.IsRead)
        {
            <span class="badge bg-success">

                Read

            </span>
        }
        else
        {
            <span class="badge bg-warning text-dark">

                Unread

            </span>
        }

    </div>

    <hr />

    <div class="mb-4">

        <h5>Message</h5>

        <p class="notification-message">

            @Model.Message

        </p>

    </div>

    <div class="row">

        <div class="col-md-6">

            <strong>Date</strong>

            <p>

                @Model.NotificationDate.ToString("dd.MM.yyyy HH:mm")

            </p>

        </div>

        <div class="col-md-6">

            <strong>Status</strong>

            <p>

                @(Model.IsRead ? "Read" : "Unread")

            </p>

        </div>

    </div>

    <hr />

    <div class="d-flex justify-content-end gap-3">

        @if (!Model.IsRead)
        {
            <form asp-action="MarkAsRead"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline">

                <button type="submit"
                        class="btn-primary-custom">

                    <i class="fa-solid fa-check"></i>

                    Mark As Read

                </button>

            </form>
        }

        <a asp-action="Index"
           class="btn-outline-custom">

            Back

        </a>

    </div>

</div>