@model TH.MVCUI.Models.ViewModels.SearchVm

@{
    ViewData["Title"] = "Search";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

@if (!string.IsNullOrWhiteSpace(Model.Keyword))
{
    <div class="dashboard-header">

        <div class="dashboard-title">

            <h2>

                Search Results

            </h2>

            <p>

                "@Model.Keyword" için
                <strong>@Model.TotalResultCount</strong>
                sonuç bulundu.

            </p>

        </div>

    </div>
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Search Results</h1>

        <p>

            Results for "<strong>@Model.Keyword</strong>"

        </p>

    </div>

</div>

@if (!Model.Projects.Any() &&
   !Model.Tasks.Any() &&
   !Model.Users.Any())
{
    <div class="dashboard-card text-center py-5">

        <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>

        <h4>No results found</h4>

        <p class="text-muted">

            Try another keyword.

        </p>

    </div>
}
else
{

    <!-- Projects -->
    @if (Model.Projects.Any())
    {
        <div class="search-section">

            <h4>Projects</h4>

            <table class="table">

                <thead>
                    <tr>
                        <th>Project Name</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Projects)
                    {
                        <tr>

                            <td>
                                @item.ProjectName
                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-area="Admin"
                                       asp-controller="Project"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>
                                }
                                else
                                {
                                    <a asp-area="Member"
                                       asp-controller="MyProject"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <!-- Tasks -->
    @if (Model.Tasks.Any())
    {
        <div class="search-section">

            <h4>Tasks</h4>

            <table class="table">

                <thead>

                    <tr>
                        <th>Task</th>
                        <th>Priority</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Tasks)
                    {
                        <tr>

                            <td>
                                @item.Title
                            </td>

                            <td>
                                @item.Priority
                            </td>

                            <td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-area="Admin"
                                       asp-controller="Task"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>
                                }
                                else
                                {
                                    <a asp-area="Member"
                                       asp-controller="MyTask"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <!-- Users -->
    @if (Model.Users.Any())
    {
        <div class="search-section">

            <h4>Users</h4>

            <table class="table">

                <thead>

                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Users)
                    {
                        <tr>

                            <td>
                                @item.FirstName @item.LastName
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-area="Admin"
                                       asp-controller="User"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>
                                }
                                else
                                {
                                    <a asp-area="Member"
                                       asp-controller="Profile"
                                       asp-action="Index"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    @if (!Model.Projects.Any()
   && !Model.Tasks.Any()
   && !Model.Users.Any())
    {
        <div class="search-empty">

            <i class="fa-solid fa-magnifying-glass"></i>

            <h3>

                Sonuç Bulunamadı!

            </h3>

            <p>

                Aramanızla eşleşen hiçbir şey bulunamadı

            </p>

        </div>
    }
}