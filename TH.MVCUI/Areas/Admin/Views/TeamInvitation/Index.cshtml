@model List<TH.MVCUI.Models.ViewModels.TeamViewModels.TeamInvitationViewModel>

@{
    ViewData["Title"] = "Takım Davetleri";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Takım Davetleri</h2>
            <p class="text-muted mb-0">
                Size gönderilen takım davetlerini buradan yönetebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Team"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="fa-solid fa-users me-1"></i>
            Takımlarım
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">

            <i class="fa-regular fa-envelope-open fa-3x text-muted mb-3"></i>

            <h5>Bekleyen davetiniz bulunmuyor.</h5>

            <p class="text-muted">
                Şu anda size gönderilmiş herhangi bir takım daveti yok.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var invitation in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">

                                <div class="me-3">

                                    <div class="rounded-circle bg-primary text-white
                                            d-flex align-items-center justify-content-center"
                                         style="width:45px;height:45px;">

                                        <i class="fa-solid fa-users"></i>

                                    </div>

                                </div>

                                <div>
                                    <h5 class="card-title mb-1">
                                        @invitation.TeamName
                                    </h5>

                                    <small class="text-muted">
                                        Takım Daveti
                                    </small>
                                </div>

                            </div>

                            <p class="mb-2">

                                <strong>
                                    @invitation.InvitedByUserName
                                </strong>

                                sizi bu takıma davet etti.

                            </p>

                            <p class="text-muted small mb-4">

                                <i class="fa-regular fa-clock me-1"></i>

                                @invitation.CreatedDate.ToString("dd.MM.yyyy HH:mm")

                            </p>

                            <div class="d-flex gap-2">

                                <form asp-area="Admin"
                                      asp-controller="TeamInvitation"
                                      asp-action="Accept"
                                      method="post"
                                      class="flex-grow-1">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@invitation.Id" />

                                    <button type="submit"
                                            class="btn btn-success w-100">

                                        <i class="fa-solid fa-check me-1"></i>
                                        Kabul Et

                                    </button>

                                </form>

                                <form asp-area="Admin"
                                      asp-controller="TeamInvitation"
                                      asp-action="Reject"
                                      method="post"
                                      class="flex-grow-1">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@invitation.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100">

                                        <i class="fa-solid fa-xmark me-1"></i>
                                        Reddet

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
