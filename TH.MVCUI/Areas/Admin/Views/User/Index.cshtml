@model TH.MVCUI.Areas.Admin.Models.PageVMs.UserPageVm

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>User Management</h1>

        <p>
            Manage all users in TaskHive.
        </p>

    </div>

    <a asp-action="Create"
       class="btn-primary-custom">

        <i class="fa-solid fa-plus"></i>

        New User

    </a>

</div>

@await Html.PartialAsync("_UserStatistics", Model)

@await Html.PartialAsync("_UserFilters")

@await Html.PartialAsync("_UserCards", Model)