@model TH.MVCUI.Areas.Admin.Models.PageVMs.UserVM.UserIndexVm

<form asp-action="Index"
	  method="get">

	<div class="dashboard-card mb-4">

		<div class="row g-3">

			<!-- Search -->

			<div class="col-md-4">

				<input type="text"
					   name="search"
					   value="@Model.Search"
					   class="form-control"
					   placeholder="Search user..." />

			</div>

			<!-- Role -->
			<div class="col-md-3">

				<select name="roleId"
						class="form-select">

					<option value="">
						All Roles
					</option>

					@foreach (var role in Model.Roles)
					{
						if (Model.RoleId == role.Id)
						{
							<option value="@role.Id" selected>
								@role.Name
							</option>
						}
						else
						{
							<option value="@role.Id">
								@role.Name
							</option>
						}
					}

				</select>

			</div>


			<!-- Status -->

			<div class="col-md-3">

				<select name="status"
						class="form-select">

					<option value="">
						All Status
					</option>

					@if (Model.Status == "Inserted")
					{
						<option value="Inserted" selected>
							Active
						</option>
					}
					else
					{
						<option value="Inserted">
							Active
						</option>
					}

					@if (Model.Status == "Deleted")
					{
						<option value="Deleted" selected>
							Passive
						</option>
					}
					else
					{
						<option value="Deleted">
							Passive
						</option>
					}

				</select>

			</div>


			<!-- Filter Button -->

			<div class="col-md-2">

				<button type="submit"
						class="btn-primary-custom w-100">

					<i class="fa fa-filter"></i>

					Filter

				</button>

			</div>

		</div>

	</div>

</form>
