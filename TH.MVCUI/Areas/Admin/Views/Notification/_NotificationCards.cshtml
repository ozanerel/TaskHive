@model TH.MVCUI.Areas.Admin.Models.PageVMs.NotificationVM.NotificationIndexVm

<div class="row g-4">

    @foreach (var notification in Model.Notifications)
    {
        <div class="col-xl-4 col-lg-6">

            <div class="dashboard-card notification-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="notification-icon">

                            @if (notification.IsRead)
                            {
                                <i class="fa-solid fa-envelope-open"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-envelope"></i>
                            }

                        </div>

                        <h3 class="mt-3">

                            @notification.Title

                        </h3>

                        <p class="text-muted">

                            @notification.NotificationDate.ToString("dd.MM.yyyy HH:mm")

                        </p>

                    </div>

                    <span class="status-badge">

                        @(notification.IsRead ? "Read" : "Unread")

                    </span>

                </div>

                <hr />

                <p class="text-muted">

                    @(string.IsNullOrWhiteSpace(notification.Message)
                        ? "No message"
                        : notification.Message.Length > 90
                        ? notification.Message.Substring(0, 90) + "..."
                        : notification.Message)

                </p>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Details"
                       asp-route-id="@notification.Id"
                       class="btn-outline-custom">

                        <i class="fa-solid fa-eye"></i>

                    </a>

                    @if (!notification.IsRead)
                    {
                        <form asp-action="MarkAsRead"
                              asp-route-id="@notification.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn-success">

                                <i class="fa-solid fa-check"></i>

                            </button>

                        </form>
                    }
                    else
                    {
                        <button class="btn-success"
                                disabled>

                            <i class="fa-solid fa-check"></i>

                        </button>
                    }

                </div>

            </div>

        </div>
    }
</div>
