@model TH.MVCUI.Areas.Admin.Models.PageVMs.NotificationVM.NotificationDetailsVm

@{
    ViewData["Title"] = "Notification Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Notification Details</h1>

        <p>

            View notification information.

        </p>

    </div>

</div>

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <h2>

                @Model.Title

            </h2>

            <p class="text-muted">

                @Model.NotificationDate.ToString("dd.MM.yyyy HH:mm")

            </p>

        </div>

        <span class="status-badge">

            @(Model.IsRead ? "Read" : "Unread")

        </span>

    </div>

    <hr />

    <h5 class="mb-3">

        Message

    </h5>

    <p class="text-muted">

        @Model.Message

    </p>

    <hr />

    <div class="row">

        <div class="col-md-6">

            <strong>User</strong>

            <p>

                @(Model.User != null
                    ? Model.User.FirstName + " " + Model.User.LastName
                    : "-")

            </p>

        </div>

        <div class="col-md-6">

            <strong>Status</strong>

            <p>

                @(Model.IsRead ? "Read" : "Unread")

            </p>

        </div>

    </div>

    <div class="d-flex justify-content-end gap-3 mt-4">

        <a asp-action="Index"
           class="btn-outline-custom">

            Back

        </a>

        @if (!Model.IsRead)
        {
            <a asp-action="MarkAsRead"
               asp-route-id="@Model.Id"
               class="btn-primary-custom">

                <i class="fa-solid fa-check"></i>

                Mark as Read

            </a>
        }

    </div>

</div>