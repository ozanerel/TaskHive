@using TH.MVCUI.Areas.Admin.Models.PageVMs.ProjectVM
@using TH.ENTITIES.Enums

@model ProjectIndexVm

<div class="project-grid">

    @foreach (var project in Model.Projects)
    {
        var totalTask = project.Tasks?.Count ?? 0;

        var completedTask = project.Tasks?.Count(x => x.IsCompleted) ?? 0;

        var progress = totalTask == 0
        ? 0
        : (completedTask * 100) / totalTask;

        <div class="project-card"
             role="button"
             tabindex="0"
             data-details-url="@Url.Action("Details", new { id = project.Id })">

            <!-- CARD HEADER -->
            <div class="project-card-header">

                <div class="project-card-title">

                    <h3>
                        @project.ProjectName
                    </h3>

                    @if (project.Status == DataStatus.Deleted)
                    {
                        <span class="badge bg-danger">
                            Passive
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }

                </div>


                <!-- THREE DOT MENU -->
                <div class="project-menu dropdown">

                    <button type="button"
                            class="project-menu-button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Project actions">

                        <i class="fa-solid fa-ellipsis"></i>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <!-- DETAILS -->

                        <li>

                            <a asp-action="Details"
                               asp-route-id="@project.Id"
                               class="dropdown-item">

                                <i class="fa-solid fa-eye"></i>

                                <span>Details</span>

                            </a>

                        </li>


                        <!-- EDIT -->

                        <li>

                            <a asp-action="Update"
                               asp-route-id="@project.Id"
                               class="dropdown-item">

                                <i class="fa-solid fa-pen"></i>

                                <span>Edit</span>

                            </a>

                        </li>


                        <!-- DELETE -->
                        @if (project.Status != DataStatus.Deleted)
                        {
                            <li>

                                <hr class="dropdown-divider" />

                            </li>

                            <li>

                                <a asp-action="Delete"
                                   asp-route-id="@project.Id"
                                   class="dropdown-item text-danger">

                                    <i class="fa-solid fa-trash"></i>

                                    <span>Delete</span>

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>


            <!-- DESCRIPTION -->

            <p class="project-description">

                @project.Description

            </p>


            <!-- PROGRESS -->

            <div class="progress-section">

                <div class="progress-info">

                    <span>Progress</span>

                    <span>@progress%</span>

                </div>

                <div class="progress">

                    <div class="progress-bar"
                         style="width:@progress%">
                    </div>

                </div>

            </div>


            <!-- STATS -->

            <div class="project-stats">

                <div>

                    <i class="fa-solid fa-users"></i>

                    @(project.Users?.Count ?? 0) Members

                </div>

                <div>

                    <i class="fa-solid fa-list-check"></i>

                    @totalTask Tasks

                </div>

            </div>

        </div>
    }

</div>


@section Scripts {

    <script>

        document.querySelectorAll(".project-card").forEach(card => {

            card.addEventListener("click", function (event) {

                // Dropdown/menu içerisindeki tıklamalar
                // kartın Details sayfasına gitmesini engeller.

                if (event.target.closest(".project-menu")) {
                    return;
                }

                const detailsUrl = card.dataset.detailsUrl;

                if (detailsUrl) {
                    window.location.href = detailsUrl;
                }

            });


            // Klavye ile kart açabilmek için
            card.addEventListener("keydown", function (event) {

                if (event.key === "Enter" || event.key === " ") {

                    if (event.target.closest(".project-menu")) {
                        return;
                    }

                    event.preventDefault();

                    const detailsUrl = card.dataset.detailsUrl;

                    if (detailsUrl) {
                        window.location.href = detailsUrl;
                    }

                }

            });

        });

    </script>

}