@model TH.MVCUI.Areas.Admin.Models.PageVMs.ProjectPageVm

@{
    ViewData["Title"] = "Update Project";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Update Project

        </h1>

        <p class="page-subtitle">

            Edit project information.

        </p>

    </div>

</div>

<div class="form-card">

    <form asp-action="Update" method="post">

        <input asp-for="Project.Id" type="hidden" />

        <div class="row">

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Project Name

                </label>

                <input asp-for="Project.ProjectName"
                       class="form-control-custom" />

                <span asp-validation-for="Project.ProjectName"
                      class="text-danger"></span>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Description

                </label>

                <textarea asp-for="Project.Description"
                          rows="6"
                          class="form-control-custom"></textarea>

                <span asp-validation-for="Project.Description"
                      class="text-danger"></span>

            </div>

        </div>

        <div class="form-buttons">

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-pen"></i>

                Update Project

            </button>

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}