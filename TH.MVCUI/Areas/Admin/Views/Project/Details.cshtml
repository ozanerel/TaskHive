@using TH.MVCUI.Areas.Admin.Models.PageVMs.ProjectVM
@model ProjectPageVm

@{
    ViewData["Title"] = "Project Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

@await Html.PartialAsync("_ProjectDetailsHeader", Model)

<div class="dashboard-grid">

    <div>

        @await Html.PartialAsync("_ProjectStatistics", Model)

        <br />

        @await Html.PartialAsync("_ProjectMembers", Model)

        <br />

        @await Html.PartialAsync("_ProjectTasks", Model)

    </div>

    <div>

        @await Html.PartialAsync("_ProjectQuickActions", Model)

    </div>

</div>