@using TH.MVCUI.Areas.Admin.Models.PageVMs.ProjectVM
@model ProjectCreateVm

@{
    ViewData["Title"] = "Create Project";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Create Project

        </h1>

        <p class="page-subtitle">

            Create a new project for your team.

        </p>

    </div>

</div>

<div class="form-card">

    <form asp-action="Create"
          asp-controller="Project"
          asp-area="Admin"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger">
        </div>
        <div class="row">

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Project Name

                </label>

                <input asp-for="ProjectName"
                       class="form-control-custom" />

                <span asp-validation-for="ProjectName"
                      class="text-danger"></span>

            </div>

            <div class="mb-3">
                <label asp-for="TeamId" class="form-label">Team</label>

                <select asp-for="TeamId" class="form-select">
                    <option value="">-- Team Seçiniz --</option>

                    @foreach (var team in Model.Teams)
                    {
                        <option value="@team.Id">
                            @team.Name
                        </option>
                    }
                </select>

                <span asp-validation-for="TeamId" class="text-danger"></span>
            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Description

                </label>

                <textarea asp-for="Description"
                          rows="6"
                          class="form-control-custom"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Assign Users
                </label>


                <select asp-for="UserIds"
                        class="form-select"
                        multiple>


                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">

                            @user.FirstName @user.LastName

                        </option>
                    }


                </select>

            </div>

        </div>

        <div class="form-buttons">

            <button type="submit" class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Project

            </button>

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}