@using TH.MVCUI.Areas.Admin.Models.PageVMs.ProjectVM
@using TH.ENTITIES.Enums

@model ProjectDetailsVm

@{
    var totalTask = Model.Tasks?.Count ?? 0;

    var completedTask = Model.Tasks?.Count(x => x.IsCompleted) ?? 0;

    var progress = totalTask == 0
        ? 0
        : (completedTask * 100) / totalTask;
}

<div class="project-details-header">

    <div class="project-details-main">

        <a asp-action="Index"
           class="btn-outline-custom project-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back

        </a>

        <div class="project-details-title">

            <div class="d-flex align-items-center gap-3">

                <h1>
                    @Model.ProjectName
                </h1>

                @if (Model.Status == DataStatus.Deleted)
                {
                    <span class="status-badge passive">
                        Passive
                    </span>
                }
                else
                {
                    <span class="status-badge active">
                        Active
                    </span>
                }

            </div>

            <p>
                @Model.Description
            </p>

        </div>

    </div>


    <div class="project-details-progress">

        <div class="project-progress-circle">

            <span>
                @progress%
            </span>

        </div>

        <small>
            Project Progress
        </small>

    </div>

</div>