@model TH.MVCUI.Areas.Admin.Models.PageVMs.ProjectPageVm

<div class="page-header">

    <div>

        <h1 class="page-title">

            Projects

        </h1>

        <p class="page-subtitle">

            Manage all projects, monitor progress and organize your team.

        </p>

    </div>

    <div class="page-actions">

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="Create"
           class="btn-primary-custom">

            <i class="fa-solid fa-plus"></i>

            New Project

        </a>

    </div>

</div>