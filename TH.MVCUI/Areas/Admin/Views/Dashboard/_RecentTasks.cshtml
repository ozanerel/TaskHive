@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>Recent Tasks</h3>

        <a asp-area="Admin"
           asp-controller="Task"
           asp-action="Index"
           class="btn btn-sm btn-outline-primary">

            View All

        </a>

    </div>

    @if (Model.RecentTasks != null && Model.RecentTasks.Any())
    {
        foreach (var task in Model.RecentTasks)
        {
            <div class="project-item">

                <div class="project-left">

                    <div class="project-icon">

                        @if (task.IsCompleted)
                        {
                            <i class="fa-solid fa-circle-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-list-check"></i>
                        }

                    </div>

                    <div>

                        <div class="project-name">

                            @task.Title

                        </div>

                        <div class="project-date">

                            @task.CreatedDate.ToString("dd MMM yyyy")

                        </div>

                    </div>

                </div>

                <div>

                    @switch (task.Priority)
                    {
                        case TH.ENTITIES.Enums.PriorityLevel.Low:
                            <span class="badge bg-success">
                                Low
                            </span>
                            break;

                        case TH.ENTITIES.Enums.PriorityLevel.Medium:
                            <span class="badge bg-warning text-dark">
                                Medium
                            </span>
                            break;

                        case TH.ENTITIES.Enums.PriorityLevel.High:
                            <span class="badge bg-danger">
                                High
                            </span>
                            break;

                        case TH.ENTITIES.Enums.PriorityLevel.Critical:
                            <span class="badge bg-dark">
                                Critical
                            </span>
                            break;
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-list-check fa-3x text-secondary mb-3"></i>

            <h5>No task found.</h5>

        </div>
    }

</div>