<div class="dashboard-card">

    <h3 class="mb-4">

        Quick Actions

    </h3>

    <div class="quick-actions">

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="Create"
           class="quick-action blue">

            <i class="fa-solid fa-diagram-project"></i>

            <span>New Project</span>

        </a>

        <a asp-area="Admin"
           asp-controller="Task"
           asp-action="Create"
           class="quick-action teal">

            <i class="fa-solid fa-list-check"></i>

            <span>New Task</span>

        </a>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Create"
           class="quick-action purple">

            <i class="fa-solid fa-user-plus"></i>

            <span>New User</span>

        </a>

        <a asp-area="Admin"
           asp-controller="Notification"
           asp-action="Index"
           class="quick-action orange">

            <i class="fa-solid fa-bell"></i>

            <span>Notification Center</span>

        </a>

    </div>

</div>