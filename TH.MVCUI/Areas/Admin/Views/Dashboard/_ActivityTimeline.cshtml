@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>Recent Activity</h3>

        <a asp-area="Admin"
           asp-controller="Task"
           asp-action="Index"
           class="btn btn-sm btn-outline-primary">

            View All

        </a>

    </div>

    @if (Model.RecentTasks != null && Model.RecentTasks.Any())
    {
        foreach (var task in Model.RecentTasks.Take(5))
        {
            bool isOverdue =
            !task.IsCompleted &&
            task.DueDate.HasValue &&
            task.DueDate.Value < DateTime.Now;

            <div class="activity">

                <div class="activity-avatar">

                    @if (task.IsCompleted)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else if (isOverdue)
                    {
                        <i class="fa-solid fa-clock"></i>
                    }
                    else
                    {
                        @(string.IsNullOrWhiteSpace(task.Title)
                            ? "?"
                            : task.Title.Substring(0, 1).ToUpper())
                    }

                </div>

                <div class="activity-content">

                    <h5>
                        @task.Title
                    </h5>

                    @if (task.IsCompleted && task.CompletedDate.HasValue)
                    {
                        <p>
                            Task completed
                            •
                            @task.CompletedDate.Value.ToString("dd MMM yyyy")
                        </p>
                    }
                    else if (isOverdue)
                    {
                        <p class="text-danger">
                            Task overdue
                            •
                            @task.DueDate.Value.ToString("dd MMM yyyy")
                        </p>
                    }
                    else
                    {
                        <p>
                            Task created
                            •
                            @task.CreatedDate.ToString("dd MMM yyyy")
                        </p>
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-4">

            <i class="fa-solid fa-clock-rotate-left fa-3x text-secondary mb-3"></i>

            <h5>No recent activity</h5>

        </div>
    }

</div>