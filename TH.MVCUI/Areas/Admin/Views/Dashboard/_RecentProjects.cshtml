@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>Recent Projects</h3>

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="Index"
           class="btn btn-sm btn-outline-primary">

            View All

        </a>

    </div>

    @if (Model.RecentProjects != null && Model.RecentProjects.Any())
    {
        foreach (var project in Model.RecentProjects)
        {
            <div class="project-item">

                <div class="project-left">

                    <div class="project-icon">

                        <i class="fa-solid fa-diagram-project"></i>

                    </div>

                    <div>

                        <div class="project-name">

                            @project.ProjectName

                        </div>

                        <div class="project-date">

                            Created :
                            @project.CreatedDate.ToString("dd MMM yyyy")

                        </div>

                    </div>

                </div>

                <a asp-area="Admin"
                   asp-controller="Project"
                   asp-action="Details"
                   asp-route-id="@project.Id"
                   class="btn btn-sm btn-primary">

                    Details

                </a>

            </div>
        }
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-folder-open fa-3x text-secondary mb-3"></i>

            <h5>No project found.</h5>

        </div>
    }

</div>