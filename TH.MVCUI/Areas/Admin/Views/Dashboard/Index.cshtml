@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-container">

    @await Html.PartialAsync("_StatisticCards", Model)

    <div class="dashboard-grid">

        <div>

            @await Html.PartialAsync("_RecentProjects", Model)

            <br />

            @await Html.PartialAsync("_ActivityTimeline", Model)

        </div>

        <div>

            @await Html.PartialAsync("_RecentTasks", Model)

            <br />

            @await Html.PartialAsync("_ProjectProgress")

            <br />

            @await Html.PartialAsync("_TeamMember",Model)

        </div>

    </div>

</div>