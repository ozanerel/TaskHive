@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>System Progress</h3>

        <span class="text-muted">
            Current Status
        </span>

    </div>

    <canvas id="projectChart" height="260"></canvas>

    <div class="text-center mt-4">

        <h2>
            @($"{Model.CompletionRate:0.##}%")
        </h2>

        <p class="text-muted">
            Task Completion Rate
        </p>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const ctx = document.getElementById('projectChart');

    if (ctx) {
        new Chart(ctx, {
            type: 'doughnut',

            data: {
                labels: [
                    'Completed',
                    'Pending',
                    'Overdue'
                ],

                datasets: [{
                    data: [
    @Model.CompletedTasks,
    @(Model.PendingTasks - Model.OverdueTasks),
    @Model.OverdueTasks
                    ],

                    backgroundColor: [
                        '#4EDBD2',
                        '#15157D',
                        '#E5484D'
                    ],

                    borderWidth: 0
                }]
            },

            options: {
                responsive: true,

                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                },

                cutout: '75%'
            }
        });
    }

</script>