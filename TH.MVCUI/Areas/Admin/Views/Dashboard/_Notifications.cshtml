@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>Recent Notifications</h3>

        <a asp-area="Admin"
           asp-controller="Notification"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm">

            View All

        </a>

    </div>

    @if (Model.RecentNotifications.Any())
    {
        foreach (var notification in Model.RecentNotifications)
        {
            <div class="notification-item">

                <div class="notification-icon">

                    @if (notification.IsRead)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-bell"></i>
                    }

                </div>

                <div class="notification-content">

                    <h5>

                        @notification.Title

                    </h5>

                    <p>

                        @notification.Message

                    </p>

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-bell-slash fa-3x text-secondary"></i>

            <h5 class="mt-3">

                No Notification

            </h5>

        </div>
    }

</div>