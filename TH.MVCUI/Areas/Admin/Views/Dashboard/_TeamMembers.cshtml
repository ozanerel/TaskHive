@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>Team Members</h3>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm">

            View All

        </a>

    </div>

    <div class="member-list">

        @if (Model.RecentUsers != null && Model.RecentUsers.Any())
        {
            foreach (var user in Model.RecentUsers)
            {
                var fullName = $"{user.FirstName} {user.LastName}".Trim();

                var avatarLetter = !string.IsNullOrWhiteSpace(user.FirstName)
                ? user.FirstName.Substring(0, 1).ToUpper()
                : "U";

                <div class="member-item">

                    <div class="member-avatar">

                        @avatarLetter

                    </div>

                    <div class="member-info">

                        <h5>
                            @(string.IsNullOrWhiteSpace(fullName)
                                ? "Unknown User"
                                : fullName)
                        </h5>

                        <span>
                            @(user.Role?.Name ?? "No Role")
                        </span>

                        @if (!string.IsNullOrWhiteSpace(user.Email))
                        {
                            <small class="text-muted d-block">
                                @user.Email
                            </small>
                        }

                    </div>

                    <span class="badge bg-success">
                        Active
                    </span>

                </div>
            }
        }
        else
        {
            <div class="text-center py-4">

                <i class="fa-solid fa-users fa-3x text-secondary mb-3"></i>

                <h5>No team members found.</h5>

            </div>
        }

    </div>

</div>