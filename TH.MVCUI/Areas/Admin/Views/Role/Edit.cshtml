@model TH.MVCUI.Areas.Admin.Models.PageVMs.RoleVM.RoleUpdateVm

@{
    ViewData["Title"] = "Edit Role";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Edit Role</h1>

        <p>Update role information.</p>

    </div>

</div>

<div class="dashboard-card">

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="RoleName"
                           class="form-label">

                        Role Name

                    </label>

                    <input asp-for="RoleName"
                           class="form-control" />

                    <span asp-validation-for="RoleName"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="mb-4">

            <label asp-for="Description"
                   class="form-label">

                Description

            </label>

            <textarea asp-for="Description"
                      rows="5"
                      class="form-control">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>

        </div>

        <div class="d-flex justify-content-end gap-3">

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Update Role

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}