@model TH.MVCUI.Areas.Admin.Models.PageVMs.RolePageVm

@{
    ViewData["Title"] = "Create Role";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="dashboard-header">

    <div class="dashboard-title">

        <h1>Create Role</h1>

        <p>Create a new role for the system.</p>

    </div>

</div>

<div class="dashboard-card">

    <form asp-action="Create" method="post">

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="Role.Name" class="form-label">
                        Role Name
                    </label>

                    <input asp-for="Role.Name" class="form-control" />

                    <span asp-validation-for="Role.Name"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="mb-4">

            <label asp-for="Role.Description"
                   class="form-label">
                Description
            </label>

            <textarea asp-for="Role.Description"
                      rows="5"
                      class="form-control">
            </textarea>

            <span asp-validation-for="Role.Description"
                  class="text-danger">
            </span>

        </div>

        <div class="d-flex justify-content-end gap-3">

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Role

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}