@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskCommentVM.TaskCommentIndexVm

@{
    ViewData["Title"] = "Comments";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Comments

        </h1>

        <p class="page-subtitle">

            View and manage comments from your teams.

        </p>

    </div>

</div>

<div class="dashboard-card">

    @if (Model.Comments != null &&
    Model.Comments.Any())
    {
        foreach (var comment in Model.Comments)
        {
            <div class="activity">

                <div class="activity-avatar">

                    @if (comment.User != null &&
                   !string.IsNullOrEmpty(comment.User.FirstName))
                    {
                        @comment.User.FirstName.Substring(0, 1)
                    }
                    else
                    {
                        <span>?</span>
                    }

                </div>

                <div class="activity-content">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5>

                                @if (comment.User != null)
                                {
                                    @comment.User.FirstName
                                    @comment.User.LastName
                                }
                                else
                                {
                                    <span>Unknown User</span>
                                }

                            </h5>

                            @if (comment.Task != null)
                            {
                                <small class="text-muted">

                                    Task:
                                    @comment.Task.Title

                                </small>
                            }

                        </div>

                        <div class="d-flex gap-2">

                            <a asp-area="Admin"
                               asp-controller="TaskComment"
                               asp-action="Details"
                               asp-route-id="@comment.Id"
                               class="btn-outline-custom">

                                <i class="fa-solid fa-eye"></i>

                                Details

                            </a>

                            <a asp-area="Admin"
                               asp-controller="TaskComment"
                               asp-action="Delete"
                               asp-route-id="@comment.Id"
                               class="btn btn-sm btn-danger">

                                <i class="fa-solid fa-trash"></i>

                                Delete

                            </a>

                        </div>

                    </div>

                    <p class="mt-2">

                        @comment.Message

                    </p>

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-4">

            <p class="text-muted mb-0">

                No comments found.

            </p>

        </div>
    }

</div>