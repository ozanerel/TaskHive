@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskCommentVM.TaskCommentDetailsVm

@{
    ViewData["Title"] = "Comment Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Comment Details

        </h1>

        <p class="page-subtitle">

            Detailed information about the selected comment.

        </p>

    </div>

</div>

<div class="dashboard-card">

    <div class="mb-4">

        <label class="text-muted">

            User

        </label>

        <h5>

            @if (Model.Comment.User != null)
            {
                @Model.Comment.User.FirstName
                @Model.Comment.User.LastName
            }
            else
            {
                <span>Unknown User</span>
            }

        </h5>

    </div>

    <div class="mb-4">

        <label class="text-muted">

            Task

        </label>

        <h5>

            @if (Model.Comment.Task != null)
            {
                @Model.Comment.Task.Title
            }
            else
            {
                <span>Unknown Task</span>
            }

        </h5>

    </div>

    <div class="mb-4">

        <label class="text-muted">

            Comment Date

        </label>

        <p>

            @Model.Comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")

        </p>

    </div>

    <div class="mb-4">

        <label class="text-muted">

            Comment

        </label>

        <div class="border rounded p-3 mt-2">

            @Model.Comment.Message

        </div>

    </div>

    <div class="d-flex justify-content-end gap-3">

        @if (Model.Comment.Task != null)
        {
            <a asp-area="Admin"
               asp-controller="Task"
               asp-action="Details"
               asp-route-id="@Model.Comment.TaskId"
               class="btn-outline-custom">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Task

            </a>
        }

        <a asp-area="Admin"
           asp-controller="TaskComment"
           asp-action="Delete"
           asp-route-id="@Model.Comment.Id"
           class="btn-danger">

            <i class="fa-solid fa-trash"></i>

            Delete

        </a>

    </div>

</div>