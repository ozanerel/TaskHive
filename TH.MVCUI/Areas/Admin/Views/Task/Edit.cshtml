@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskPageVm

@{
    ViewData["Title"] = "Edit Task";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Edit Task

        </h1>

        <p class="page-subtitle">

            Update task information.

        </p>

    </div>

</div>

<div class="form-card">

    <form asp-action="Edit"
          method="post">

        <input asp-for="Task.Id" type="hidden" />

        <div class="row">

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Title
                </label>

                <input asp-for="Task.Title"
                       class="form-control-custom" />

                <span asp-validation-for="Task.Title"
                      class="text-danger"></span>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Description
                </label>

                <textarea asp-for="Task.Description"
                          rows="5"
                          class="form-control-custom"></textarea>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Priority
                </label>

                <select asp-for="Task.Priority"
                        class="form-control-custom">

                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>

                </select>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Assigned User
                </label>

                <select asp-for="Task.UserId"
                        class="form-control-custom">

                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">

                            @user.FirstName @user.LastName

                        </option>
                    }

                </select>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Project
                </label>

                <select asp-for="Task.ProjectId"
                        class="form-control-custom">

                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">

                            @project.ProjectName

                        </option>
                    }

                </select>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">

                    Status

                </label>

                <div class="form-check mt-2">

                    <input asp-for="Task.IsCompleted"
                           class="form-check-input" />

                    <label asp-for="Task.IsCompleted"
                           class="form-check-label">

                        Completed

                    </label>

                </div>

            </div>

        </div>

        <div class="form-buttons">

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Changes

            </button>

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}