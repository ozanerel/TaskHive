@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskUpdateVm

@{
    ViewData["Title"] = "Edit Task";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Edit Task

        </h1>

        <p class="page-subtitle">

            Update task information.

        </p>

    </div>

</div>

<div class="form-card">

    <form asp-action="Edit"
          method="post">

        <input asp-for="Id" type="hidden" />

        <div class="row">

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Title
                </label>

                <input asp-for="Title"
                       class="form-control-custom" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          rows="5"
                          class="form-control-custom"></textarea>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Priority
                </label>

                <select asp-for="Priority"
                        class="form-control-custom">

                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="DueDate"
                       class="form-label">

                    Due Date

                </label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="DueDate"
                      class="text-danger"></span>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Required Role
                </label>

                <select asp-for="RequiredRoleId"
                        class="form-control-custom">

                    <option value="">
                        No Required Role
                    </option>

                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Id">

                            @role.Name

                        </option>
                    }

                </select>

                <span asp-validation-for="RequiredRoleId"
                      class="text-danger"></span>

            </div>

            <div class="col-md-6 mb-4">
                <label asp-for="UserId" class="form-label">
                    Assigned User
                </label>

                <select asp-for="UserId"
                        class="form-control-custom"
                        id="userSelect">

                    <option value="">
                        Select User
                    </option>

                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id"
                                data-role-id="@user.RoleId">
                            @user.FirstName @user.LastName
                        </option>
                    }
                </select>

                <span asp-validation-for="UserId"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Project
                </label>

                <select asp-for="ProjectId"
                        class="form-control-custom">

                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">

                            @project.ProjectName

                        </option>
                    }

                </select>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">

                    Status

                </label>

                <div class="form-check mt-2">

                    <input asp-for="IsCompleted"
                           class="form-check-input" />

                    <label asp-for="IsCompleted"
                           class="form-check-label">

                        Completed

                    </label>

                </div>

            </div>

        </div>

        <div class="form-buttons">

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Changes

            </button>

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const requiredRoleSelect =
                document.getElementById("requiredRoleSelect");

            const userSelect =
                document.getElementById("userSelect");

            if (!requiredRoleSelect || !userSelect) {
                return;
            }

            function filterUsersByRole() {

                const selectedRoleId =
                    requiredRoleSelect.value;

                const options =
                    userSelect.querySelectorAll("option");

                let selectedUserIsVisible = false;

                options.forEach(function (option) {

                    if (!option.value) {
                        option.hidden = false;
                        return;
                    }

                    const userRoleId =
                        option.getAttribute("data-role-id");

                    const isVisible =
                        selectedRoleId === "" ||
                        userRoleId === selectedRoleId;

                    option.hidden = !isVisible;

                    if (isVisible &&
                        option.value === userSelect.value) {

                        selectedUserIsVisible = true;
                    }
                });

                if (!selectedUserIsVisible) {
                    userSelect.value = "";
                }
            }

            requiredRoleSelect.addEventListener(
                "change",
                filterUsersByRole
            );

            filterUsersByRole();
        });
    </script>
}