@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskDetailsVm

<div class="dashboard-card">

    <h3>

        Status

    </h3>

    @if (Model.IsCompleted)
    {
        <div class="status-badge completed">

            Completed

        </div>
    }
    else
    {
        <div class="status-badge pending">

            In Progress

        </div>
    }

</div>