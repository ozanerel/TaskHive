@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskDetailsVm

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center">

        <h3>
            Comments
        </h3>

        <a asp-controller="TaskComment"
           asp-action="Index"
           asp-route-taskId="@Model.Id"
           class="btn-outline-custom">

            View All

        </a>

    </div>

    @if (Model.Comments != null &&
    Model.Comments.Any())
    {
        foreach (var comment in Model.Comments.Take(3))
        {
            <div class="activity">

                <div class="activity-avatar">

                    @comment.User.FirstName.Substring(0, 1)

                </div>

                <div class="activity-content">

                    <div class="d-flex justify-content-between align-items-start">

                        <h5>

                            @comment.User.FirstName
                            @comment.User.LastName

                        </h5>

                        <a asp-area="Admin"
                           asp-controller="TaskComment"
                           asp-action="Delete"
                           asp-route-id="@comment.Id"
                           class="btn btn-sm btn-danger">

                            <i class="fa-solid fa-trash"></i>

                        </a>

                    </div>

                    <p>

                        @comment.Message

                    </p>

                </div>

            </div>
        }
    }
    else
    {
        <p>

            No comments yet.

        </p>
    }

</div>