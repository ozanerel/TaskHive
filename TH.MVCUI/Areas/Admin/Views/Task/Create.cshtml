@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskCreateVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
	ViewData["Title"] = "Create Task";
	Layout = "~/Views/Shared/_AreaLayout.cshtml";

	var assignmentSuggestions = Model.AssignmentSuggestions
		.OrderBy(x => x.WorkloadScore)
		.ThenByDescending(x => x.CompletionRate)
		.ToList();
}

<div class="page-header">

	<div>

		<h1 class="page-title">

			Create Task

		</h1>

		<p class="page-subtitle">

			Create a new task for your project.

		</p>

	</div>

</div>

<div class="form-card">

	<form asp-action="Create"
		  method="post">

		@Html.AntiForgeryToken()

		<div asp-validation-summary="ModelOnly"
			 class="text-danger mb-3">
		</div>

		<div class="row">

			<div class="col-md-12 mb-4">

				<label class="form-label">

					Title

				</label>

				<input asp-for="Title"
					   class="form-control-custom" />

				<span asp-validation-for="Title"
					  class="text-danger">
				</span>

			</div>

			<div class="col-md-12 mb-4">

				<label class="form-label">

					Description

				</label>

				<textarea asp-for="Description"
						  rows="5"
						  class="form-control-custom">
				</textarea>

			</div>

			<div class="col-md-6 mb-4">

				<label class="form-label">

					Priority

				</label>

				<select asp-for="Priority"
						class="form-control-custom">

					<option value="Low">Low</option>

					<option value="Medium">Medium</option>

					<option value="High">High</option>

					<option value="Critical">Critical</option>

				</select>

			</div>

			<div class="mb-3">

				<label asp-for="DueDate"
					   class="form-label">

					Due Date

				</label>

				<input asp-for="DueDate"
					   type="date"
					   class="form-control" />

				<span asp-validation-for="DueDate"
					  class="text-danger">
				</span>

			</div>

			<div class="mb-3">

				<label asp-for="RequiredRoleId"
					   class="form-label">

					Gerekli Rol

				</label>

				<select asp-for="RequiredRoleId"
						class="form-select"
						asp-items="@(new SelectList(Model.Roles, "Id", "Name"))">

					<option value="">

						Rol seçiniz

					</option>

				</select>

				<span asp-validation-for="RequiredRoleId"
					  class="text-danger">
				</span>

			</div>

			<div class="col-md-6 mb-4">

				<label class="form-label">

					Assigned User

				</label>

				<select asp-for="UserId"
						id="userSelect"
						class="form-control-custom">

					<option value="">

						Önce proje seçiniz

					</option>

					@foreach (var user in Model.Users)
					{
						<option value="@user.Id" data-role-id="@user.RoleId">

							@user.FirstName @user.LastName

						</option>
					}

				</select>

				<span asp-validation-for="UserId"
					  class="text-danger">
				</span>

			</div>

			<div class="col-md-12 mb-4">

				<div class="dashboard-card">

					<div class="d-flex justify-content-end mb-3">

						<button type="button"
								id="auto-assign-user"
								class="btn btn-success">

							<i class="bi bi-magic"></i>

							En Uygun Kullanıcıyı Seç

						</button>

					</div>

					<div class="d-flex justify-content-between align-items-center mb-3">

						<h4 class="mb-0">

							<i class="fa-solid fa-lightbulb text-warning"></i>

							Assignment Suggestions

						</h4>

						<span class="text-muted">

							Lowest workload first

						</span>

					</div>

					<div class="table-responsive">

						<table class="table align-middle">

							<thead>

								<tr>

									<th>Kullanıcı</th>

									<th>Bekleyen Görev</th>

									<th>Geciken Görev</th>

									<th>Tamamlanma Oranı</th>

									<th>İş Yükü Skoru</th>

									<th>Rol</th>

									<th>İşlem</th>

								</tr>

							</thead>

							<tbody id="assignmentSuggestionsBody">

								@if (assignmentSuggestions.Any())
								{
									@foreach (var suggestion in assignmentSuggestions)
									{
										<tr data-role-id="@suggestion.RoleId">

											<td>

												@suggestion.UserName

											</td>

											<td>

												@suggestion.PendingTasks

											</td>

											<td>

												@suggestion.OverdueTasks

											</td>

											<td>

												@($"{suggestion.CompletionRate:0.##}%")

											</td>

											<td>

												@suggestion.WorkloadScore

												@if (suggestion == assignmentSuggestions.First())
												{
													<span class="badge bg-success ms-1">

														En Düşük

													</span>
												}

											</td>

											<td>

												<span class="badge bg-info text-dark">

													@suggestion.RoleName

												</span>

											</td>

											<td>

												<button type="button"
														class="btn btn-sm btn-primary select-assignment-user"
														data-user-id="@suggestion.UserId"
														data-role-id="@suggestion.RoleId">

													Seç

												</button>

											</td>

										</tr>
									}
								}
								else
								{
									<tr id="no-assignment-suggestion-row">

										<td colspan="7"
											class="text-center py-4">

											<i class="fa-solid fa-users-slash fa-2x text-secondary mb-3"></i>

											<p class="text-muted mb-0">

												Önce bir proje seçiniz.

											</p>

										</td>

									</tr>
								}

							</tbody>

						</table>

					</div>

					<div id="no-role-suggestion-message"
						 class="alert alert-info mt-3 d-none">

						Seçilen role uygun bir kullanıcı bulunamadı.

					</div>

				</div>

			</div>

			<div class="col-md-12 mb-4">

				<label class="form-label">

					Project

				</label>

				<select asp-for="ProjectId"
						id="projectSelect"
						class="form-control-custom">

					<option value="">

						Select Project

					</option>

					@foreach (var project in Model.Projects)
					{
						<option value="@project.Id">

							@project.ProjectName

						</option>
					}

				</select>

			</div>

		</div>

		<div class="form-buttons">

			<button class="btn-primary-custom"
					type="submit">

				<i class="fa-solid fa-plus"></i>

				Create Task

			</button>

			<a asp-action="Index"
			   class="btn-outline-custom">

				Cancel

			</a>

		</div>

	</form>

</div>

@section Scripts {

	<script>

		document.addEventListener("DOMContentLoaded", function () {

			const projectSelect = document.getElementById(
				"projectSelect"
			);

			const userSelect = document.getElementById(
				"userSelect"
			);

			const requiredRoleSelect = document.querySelector(
				'select[name="RequiredRoleId"]'
			);

			const suggestionsBody = document.getElementById(
				"assignmentSuggestionsBody"
			);

			const noRoleSuggestionMessage = document.getElementById(
				"no-role-suggestion-message"
			);

			const autoAssignButton = document.getElementById(
				"auto-assign-user"
			);

			let currentUser = [];

			function selectUser(userId) {

				if (!userSelect) {

					console.error(
						"UserId dropdown bulunamadı."
					);

					return;

				}

				const userOption = userSelect.querySelector(
					`option[value="${userId}"]`
				);

				if (!userOption) {

					console.error(
						"Seçilecek kullanıcı dropdown içerisinde bulunamadı."
					);

					return;

				}

				userSelect.value = userId;

				userSelect.dispatchEvent(
					new Event("change", {
						bubbles: true
					})
				);

				userSelect.scrollIntoView({

					behavior: "smooth",

					block: "center"

				});

			}


			function filterSuggestionsByRole() {

				if (!requiredRoleSelect) {

					return;

				}

				const selectedRoleId =
					requiredRoleSelect.value;

				const suggestionRows =
					document.querySelectorAll(
						"#assignmentSuggestionsBody tr[data-role-id]"
					);

				let visibleSuggestionCount = 0;


				suggestionRows.forEach(row => {

					const rowRoleId =
						row.dataset.roleId;

					const shouldShow =
						!selectedRoleId ||
						rowRoleId === selectedRoleId;


					if (shouldShow) {

						row.style.display = "";

						visibleSuggestionCount++;

					}
					else {

						row.style.display = "none";

					}

				});


				if (noRoleSuggestionMessage) {

					if (
						selectedRoleId &&
						visibleSuggestionCount === 0
					) {

						noRoleSuggestionMessage.classList.remove(
							"d-none"
						);

					}
					else {

						noRoleSuggestionMessage.classList.add(
							"d-none"
						);

					}

				}

			}


			function bindSuggestionButtons() {

				const selectButtons =
					document.querySelectorAll(
						".select-assignment-user"
					);

				selectButtons.forEach(button => {

					button.addEventListener(
						"click",
						function () {

							const userId =
								this.dataset.userId;

							selectUser(userId);

						}
					);

				});

			}


			function updateUserSelect(users) {
					currentUsers = users;
					userSelect.innerHTML =
					'<option value="">Kullanıcı seçiniz</option>';

					users.forEach(user => {
						const option = document.createElement("option");
						option.value = user.id;
						option.textContent = user.name;
						option.dataset.roleId = user.roleId ?? "";

						userSelect.appendChild(option);
					});

					filterUserSelectByRole();
			}

					function filterUserSelectByRole() {
			const selectedRoleId = requiredRoleSelect.value;

			Array.from(userSelect.options).forEach(option => {

				if (option.value === "") {
					option.hidden = false;
					return;
				}

				if (!selectedRoleId) {
					option.hidden = false;
					return;
				}

				option.hidden =
					option.dataset.roleId !== selectedRoleId;
			});

			userSelect.value = "";
		}


			function updateAssignmentSuggestions(
				suggestions
			) {

				if (!suggestionsBody) {

					return;

				}

				suggestionsBody.innerHTML = "";


				if (
					!suggestions ||
					suggestions.length === 0
				) {

					suggestionsBody.innerHTML = `
						<tr id="no-assignment-suggestion-row">

							<td colspan="7"
								class="text-center py-4">

								<i class="fa-solid fa-users-slash fa-2x text-secondary mb-3"></i>

								<p class="text-muted mb-0">

									Bu takımda önerilebilecek kullanıcı bulunamadı.

								</p>

							</td>

						</tr>
					`;

					if (autoAssignButton) {

						autoAssignButton.disabled = true;

					}

					return;

				}


				suggestions.forEach(
					(suggestion, index) => {

						const row =
							document.createElement("tr");

						row.dataset.roleId =
							suggestion.roleId ?? "";


						const lowestBadge =
							index === 0
								? `
									<span class="badge bg-success ms-1">
										En Düşük
									</span>
								  `
								: "";


						row.innerHTML = `

							<td>

								${suggestion.userName}

							</td>

							<td>

								${suggestion.pendingTasks}

							</td>

							<td>

								${suggestion.overdueTasks}

							</td>

							<td>

								${suggestion.completionRate}%

							</td>

							<td>

								${suggestion.workloadScore}

								${lowestBadge}

							</td>

							<td>

								<span class="badge bg-info text-dark">

									${suggestion.roleName}

								</span>

							</td>

							<td>

								<button type="button"
										class="btn btn-sm btn-primary select-assignment-user"
										data-user-id="${suggestion.userId}"
										data-role-id="${suggestion.roleId ?? ""}">

									Seç

								</button>

							</td>

						`;


						suggestionsBody.appendChild(row);

					}
				);


				bindSuggestionButtons();


				if (autoAssignButton) {

					autoAssignButton.disabled = false;

				}

			}


			async function loadAssignmentSuggestions(
				projectId
			) {

				if (!projectId) {

					if (userSelect) {

						userSelect.innerHTML =
							'<option value="">Önce proje seçiniz</option>';

					}


					if (suggestionsBody) {

						suggestionsBody.innerHTML = `
							<tr id="no-assignment-suggestion-row">

								<td colspan="7"
									class="text-center py-4">

									<i class="fa-solid fa-users-slash fa-2x text-secondary mb-3"></i>

									<p class="text-muted mb-0">

										Önce bir proje seçiniz.

									</p>

								</td>

							</tr>
						`;

					}


					if (autoAssignButton) {

						autoAssignButton.disabled = true;

					}

					return;

				}


				try {

					if (autoAssignButton) {

						autoAssignButton.disabled = true;

					}


					if (userSelect) {

						userSelect.innerHTML =
							'<option value="">Kullanıcılar yükleniyor...</option>';
					}


					const response = await fetch(
						'@Url.Action("GetAssignmentSuggestions", "Task", new { area = "Admin" })?projectId=' + projectId
					);


					if (!response.ok) {

						throw new Error(
							"Assignment suggestions alınamadı."
						);

					}


					const data =
						await response.json();


					updateUserSelect(
						data.users
					);


					updateAssignmentSuggestions(
						data.suggestions
					);


					filterSuggestionsByRole();

				}
				catch (error) {

					console.error(
						error
					);


					if (userSelect) {

						userSelect.innerHTML =
							'<option value="">Kullanıcılar yüklenemedi</option>';

					}


					if (suggestionsBody) {

						suggestionsBody.innerHTML = `
							<tr>

								<td colspan="7"
									class="text-center text-danger py-4">

									Kullanıcı önerileri yüklenirken bir hata oluştu.

								</td>

							</tr>
						`;

					}


					if (autoAssignButton) {

						autoAssignButton.disabled = true;

					}

				}

			}


			if (projectSelect) {

				projectSelect.addEventListener(
					"change",
					function () {

						const projectId =
							this.value;


						if (userSelect) {

							userSelect.value = "";

						}


						loadAssignmentSuggestions(
							projectId
						);

					}
				);

			}


			if (requiredRoleSelect) {

				requiredRoleSelect.addEventListener(
					"change",
					function () {

						if (userSelect) {

							userSelect.value = "";

						}

						filterSuggestionsByRole();

					}
				);

			}


			if (autoAssignButton) {

				autoAssignButton.addEventListener(
					"click",
					function () {

						const visibleSuggestionButton =
							Array.from(
								document.querySelectorAll(
									".select-assignment-user"
								)
							).find(button => {

								const row =
									button.closest("tr");


								return row &&
									   row.style.display !== "none";

							});


						if (!visibleSuggestionButton) {

							alert(
								"Seçilen role uygun bir kullanıcı bulunamadı."
							);

							return;

						}


						const userId =
							visibleSuggestionButton.dataset.userId;


						selectUser(userId);

					}
				);

			}


			bindSuggestionButtons();


			if (projectSelect && projectSelect.value) {

				loadAssignmentSuggestions(
					projectSelect.value
				);

			}
			else {

				if (autoAssignButton) {

					autoAssignButton.disabled = true;

				}

			}


			filterSuggestionsByRole();

		});

	</script>

}