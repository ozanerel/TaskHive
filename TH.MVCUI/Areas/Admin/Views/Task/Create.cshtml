@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskCreateVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Task";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";

    var assignmentSuggestions = Model.AssignmentSuggestions
        .OrderBy(x => x.WorkloadScore)
        .ThenByDescending(x => x.CompletionRate)
        .ToList();
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Create Task

        </h1>

        <p class="page-subtitle">

            Create a new task for your project.

        </p>

    </div>

</div>

<div class="form-card">

    <form asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row">

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Title

                </label>

                <input asp-for="Title"
                       class="form-control-custom" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Description

                </label>

                <textarea asp-for="Description"
                          rows="5"
                          class="form-control-custom">
                </textarea>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">

                    Priority

                </label>

                <select asp-for="Priority"
                        class="form-control-custom">

                    <option value="Low">Low</option>

                    <option value="Medium">Medium</option>

                    <option value="High">High</option>

                    <option value="Critical">Critical</option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="DueDate"
                       class="form-label">

                    Due Date

                </label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="DueDate"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="RequiredRoleId"
                       class="form-label">

                    Gerekli Rol

                </label>

                <select asp-for="RequiredRoleId"
                        class="form-select"
                        asp-items="@(new SelectList(Model.Roles, "Id", "Name"))">

                    <option value="">

                        Rol seçiniz

                    </option>

                </select>

                <span asp-validation-for="RequiredRoleId"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">

                    Assigned User

                </label>

                <select asp-for="UserId"
                        class="form-control-custom">

                    <option value="">

                        Select User

                    </option>

                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">

                            @user.FirstName @user.LastName

                        </option>
                    }

                </select>

                <span asp-validation-for="UserId"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-12 mb-4">

                <div class="dashboard-card">

                    @if (assignmentSuggestions.Any())
                    {
                        <div class="d-flex justify-content-end mb-3">

                            <button type="button"
                                    id="auto-assign-user"
                                    class="btn btn-success">

                                <i class="bi bi-magic"></i>

                                En Uygun Kullanıcıyı Seç

                            </button>

                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="mb-0">

                            <i class="fa-solid fa-lightbulb text-warning"></i>

                            Assignment Suggestions

                        </h4>

                        <span class="text-muted">

                            Lowest workload first

                        </span>

                    </div>

                    @if (assignmentSuggestions.Any())
                    {
                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>

                                        <th>Kullanıcı</th>

                                        <th>Bekleyen Görev</th>

                                        <th>Geciken Görev</th>

                                        <th>Tamamlanma Oranı</th>

                                        <th>İş Yükü Skoru</th>

                                        <th>Rol</th>

                                        <th>İşlem</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var suggestion in assignmentSuggestions)
                                    {
                                        <tr data-role-id="@suggestion.RoleId">

                                            <td>

                                                @suggestion.UserName

                                            </td>

                                            <td>

                                                @suggestion.PendingTasks

                                            </td>

                                            <td>

                                                @suggestion.OverdueTasks

                                            </td>

                                            <td>

                                                @($"{suggestion.CompletionRate:0.##}%")

                                            </td>

                                            <td>

                                                @suggestion.WorkloadScore

                                                @if (suggestion == assignmentSuggestions.First())
                                                {
                                                    <span class="badge bg-success ms-1">

                                                        En Düşük

                                                    </span>
                                                }

                                            </td>

                                            <td>

                                                <span class="badge bg-info text-dark">

                                                    @suggestion.RoleName

                                                </span>

                                            </td>

                                            <td>

                                                <button type="button"
                                                        class="btn btn-sm btn-primary select-assignment-user"
                                                        data-user-id="@suggestion.UserId"
                                                        data-role-id="@suggestion.RoleId">

                                                    Seç

                                                </button>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <div id="no-role-suggestion-message"
                             class="alert alert-info mt-3 d-none">

                            Seçilen role uygun bir kullanıcı bulunamadı.

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="fa-solid fa-users-slash fa-2x text-secondary mb-3"></i>

                            <p class="text-muted mb-0">

                                No assignment suggestions are available yet.

                            </p>

                        </div>
                    }

                </div>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">

                    Project

                </label>

                <select asp-for="ProjectId"
                        class="form-control-custom">

                    <option value="">

                        Select Project

                    </option>

                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">

                            @project.ProjectName

                        </option>
                    }

                </select>

            </div>

        </div>

        <div class="form-buttons">

            <button class="btn-primary-custom"
                    type="submit">

                <i class="fa-solid fa-plus"></i>

                Create Task

            </button>

            <a asp-action="Index"
               class="btn-outline-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const selectButtons = document.querySelectorAll(
                ".select-assignment-user"
            );

            const userSelect = document.querySelector(
                'select[name="UserId"]'
            );

            const requiredRoleSelect = document.querySelector(
                'select[name="RequiredRoleId"]'
            );

            const suggestionRows = document.querySelectorAll(
                "tbody tr[data-role-id]"
            );

            const noRoleSuggestionMessage = document.getElementById(
                "no-role-suggestion-message"
            );


            function selectUser(userId) {

                if (!userSelect) {

                    console.error(
                        "UserId dropdown bulunamadı."
                    );

                    return;

                }

                const userOption = userSelect.querySelector(
                    `option[value="${userId}"]`
                );

                if (!userOption) {

                    console.error(
                        "Seçilecek kullanıcı dropdown içerisinde bulunamadı."
                    );

                    return;

                }

                userSelect.value = userId;

                userSelect.dispatchEvent(
                    new Event("change", {
                        bubbles: true
                    })
                );

                userSelect.scrollIntoView({

                    behavior: "smooth",

                    block: "center"

                });

            }


            function filterSuggestionsByRole() {

                if (!requiredRoleSelect) {

                    return;

                }

                const selectedRoleId = requiredRoleSelect.value;

                let visibleSuggestionCount = 0;


                suggestionRows.forEach(row => {

                    const rowRoleId = row.dataset.roleId;

                    const shouldShow =
                        !selectedRoleId ||
                        rowRoleId === selectedRoleId;


                    if (shouldShow) {

                        row.style.display = "";

                        visibleSuggestionCount++;

                    }
                    else {

                        row.style.display = "none";

                    }

                });


                if (noRoleSuggestionMessage) {

                    if (
                        selectedRoleId &&
                        visibleSuggestionCount === 0
                    ) {

                        noRoleSuggestionMessage.classList.remove(
                            "d-none"
                        );

                    }
                    else {

                        noRoleSuggestionMessage.classList.add(
                            "d-none"
                        );

                    }

                }

            }


            selectButtons.forEach(button => {

                button.addEventListener("click", function () {

                    const userId = this.dataset.userId;

                    selectUser(userId);

                });

            });


            if (requiredRoleSelect) {

                requiredRoleSelect.addEventListener(
                    "change",
                    function () {

                        if (userSelect) {

                            userSelect.value = "";

                        }

                        filterSuggestionsByRole();

                    }
                );

            }


            const autoAssignButton = document.getElementById(
                "auto-assign-user"
            );


            if (autoAssignButton) {

                autoAssignButton.addEventListener(
                    "click",
                    function () {

                        const visibleSuggestionButton =
                            Array.from(
                                document.querySelectorAll(
                                    ".select-assignment-user"
                                )
                            ).find(button => {

                                const row = button.closest("tr");

                                return row &&
                                       row.style.display !== "none";

                            });


                        if (!visibleSuggestionButton) {

                            alert(
                                "Seçilen role uygun bir kullanıcı bulunamadı."
                            );

                            return;

                        }


                        const userId =
                            visibleSuggestionButton.dataset.userId;


                        selectUser(userId);

                    }
                );

            }


            filterSuggestionsByRole();

        });

    </script>

}