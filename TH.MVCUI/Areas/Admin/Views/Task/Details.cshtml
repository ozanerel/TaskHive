@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskDetailsVm

@{
    ViewData["Title"] = "Task Details";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="page-header">

    <div>

        <h1 class="page-title">

            Task Details

        </h1>

        <p class="page-subtitle">

            Detailed information about the selected task.

        </p>

    </div>

    <div>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-primary-custom">

            <i class="fa-solid fa-pen"></i>

            Edit

        </a>

    </div>

</div>

<div class="task-detail-grid">

    @await Html.PartialAsync("_TaskInfoCard", Model)

    @await Html.PartialAsync("_TaskStatusCard", Model)

</div>

<div class="mt-4">

    @await Html.PartialAsync("_TaskDescriptionCard", Model)

</div>

<div class="mt-4">

    @await Html.PartialAsync("_TaskCommentsCard", Model)

</div>

