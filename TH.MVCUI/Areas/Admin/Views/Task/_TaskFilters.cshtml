<div class="task-filter-area">

    <div class="task-search">

        <i class="fa-solid fa-magnifying-glass"></i>

        <input type="text"
               placeholder="Search task..." />

    </div>

    <div class="task-filters">

        <select>

            <option>
                All Priorities
            </option>

            <option>
                Low
            </option>

            <option>
                Medium
            </option>

            <option>
                High
            </option>

            <option>
                Critical
            </option>

        </select>

        <select>

            <option>
                All Status
            </option>

            <option>
                Completed
            </option>

            <option>
                Pending
            </option>

        </select>

    </div>

</div>