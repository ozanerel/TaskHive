@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskIndexVm
@using TH.ENTITIES.Enums

<form asp-action="Index"
      method="get">

    <div class="task-filter-area">

        <!-- SEARCH -->

        <div class="task-search">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search task..." />

        </div>


        <div class="task-filters">

            <!-- PRIORITY -->

            <select name="priority">

                <option value="">
                    All Priorities
                </option>

                @if (Model.Priority == PriorityLevel.Low)
                {
                    <option value="@PriorityLevel.Low" selected>
                        Low
                    </option>
                }
                else
                {
                    <option value="@PriorityLevel.Low">
                        Low
                    </option>
                }

                @if (Model.Priority == PriorityLevel.Medium)
                {
                    <option value="@PriorityLevel.Medium" selected>
                        Medium
                    </option>
                }
                else
                {
                    <option value="@PriorityLevel.Medium">
                        Medium
                    </option>
                }

                @if (Model.Priority == PriorityLevel.High)
                {
                    <option value="@PriorityLevel.High" selected>
                        High
                    </option>
                }
                else
                {
                    <option value="@PriorityLevel.High">
                        High
                    </option>
                }

                @if (Model.Priority == PriorityLevel.Critical)
                {
                    <option value="@PriorityLevel.Critical" selected>
                        Critical
                    </option>
                }
                else
                {
                    <option value="@PriorityLevel.Critical">
                        Critical
                    </option>
                }

            </select>


            <!-- STATUS -->

            <select name="isCompleted">

                <option value="">
                    All Status
                </option>

                @if (Model.IsCompleted == true)
                {
                    <option value="true" selected>
                        Completed
                    </option>
                }
                else
                {
                    <option value="true">
                        Completed
                    </option>
                }

                @if (Model.IsCompleted == false)
                {
                    <option value="false" selected>
                        Pending
                    </option>
                }
                else
                {
                    <option value="false">
                        Pending
                    </option>
                }

            </select>


            <!-- FILTER BUTTON -->

            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa fa-filter"></i>

                Filter

            </button>

        </div>

    </div>

</form>