@model TH.MVCUI.Areas.Admin.Models.PageVMs.TaskVM.TaskDeleteVm

@{
    ViewData["Title"] = "Delete Task";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="delete-container">

    <div class="delete-card">

        <div class="delete-icon">

            <i class="fa-solid fa-triangle-exclamation"></i>

        </div>

        <h2>

            Delete Task

        </h2>

        <p>

            Are you sure you want to delete this task?

        </p>

        <hr />

        <div class="delete-info">

            <div>

                <span>Task</span>

                <strong>

                    @Model.Title

                </strong>

            </div>

            <div>

                <span>Project</span>

                <strong>

                    @(Model.ProjectName ?? "-")

                </strong>

            </div>

            <div>

                <span>User</span>

                <strong>

                    @(Model.UserName ?? "-")

                </strong>

            </div>

            <div>

                <span>Status</span>

                <strong>

                    @(Model.IsCompleted
                        ? "Completed"
                        : "In Progress")

                </strong>

            </div>

        </div>

        <form asp-action="Delete"
              method="post">

            <input asp-for="Id"
                   type="hidden" />

            <div class="delete-buttons">

                <button class="btn-danger-custom">

                    <i class="fa-solid fa-trash"></i>

                    Delete Task

                </button>

                <a asp-action="Index"
                   class="btn-outline-custom">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>