@model int

<a asp-area="Member"
   asp-controller="Chat"
   asp-action="Index"
   class="notification-link">

    <i class="fa-solid fa-envelope"></i>

    @if (Model > 0)
    {
        <span class="notification-count">
            @(Model >= 10 ? "10+" : Model.ToString())
        </span>
    }

</a>