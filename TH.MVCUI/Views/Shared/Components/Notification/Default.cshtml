@model int

@{
    var area = User.IsInRole("Admin") ? "Admin" : "Member";
}

<a asp-area="@area"
   asp-controller="Notification"
   asp-action="Index"
   class="notification-link">

    <i class="fa-solid fa-bell"></i>

    @if (Model > 0)
    {
        <span class="notification-count">
            @Model
        </span>
    }

</a>