@using Microsoft.AspNetCore.Identity
@using TH.ENTITIES.Models
@using TH.BLL.Managers.Abstracts

@inject UserManager<AppUser> IdentityUserManager
@inject IUserManager UserManager

@{
	var currentUser = await IdentityUserManager.GetUserAsync(User);

	var currentTaskHiveUser = currentUser == null
		? null
		: await UserManager.GetByAppUserIdAsync(currentUser.Id);

}

@{
	var profilePhoto = currentUser?.AppUserProfile?.ImageUrl;
}

<nav class="th-navbar">

	<div class="th-navbar-left">

		<button class="th-menu-btn" id="sidebarToggle">

			<i class="fa-solid fa-bars"></i>

		</button>

		@* <div class="th-search">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   placeholder="Search project, task, user..." />

        </div> *@

		<form asp-controller="Search"
			  asp-action="Index"
			  method="get"
			  class="th-search">

			<i class="fa-solid fa-magnifying-glass"></i>

			<input type="search"
				   name="keyword"
				   value="@Context.Request.Query["keyword"]"
				   placeholder="Search project, task or user..."
				   autocomplete="off" />

			@* <span class="search-shortcut">
                Enter
            </span> *@

		</form>

	</div>

	<div class="th-navbar-right">

		<!-- Notification -->

		@* <div class="th-navbar-icon">

            <i class="fa-regular fa-bell"></i>

            <span class="th-badge">3</span>

        </div> *@
		@await Component.InvokeAsync("Notification")

		<a asp-controller="TeamInvitation"
		   asp-action="Index"
		   class="th-navbar-icon"
		   title="Takım Davetleri">

			<i class="fa-solid fa-user-plus"></i>

		</a>

		<!-- Message -->

		@await Component.InvokeAsync("MessageNotification")

		<!-- User -->

		<div class="dropdown">

			<button class="th-user-button"
					type="button"
					data-bs-toggle="dropdown"
					aria-expanded="false">

				<div class="th-user-avatar">

					@if (!string.IsNullOrEmpty(profilePhoto))
					{
						<img src="@profilePhoto"
							 alt="Profile Photo" />
					}
					else
					{
						@User.Identity?.Name?.Substring(0, 1).ToUpper()
					}

				</div>

				<div class="th-user-info">

					<h6>

						@User.Identity?.Name

					</h6>

					<span>

						@(User.IsInRole("Admin") ? "Administrator" : "Member")

					</span>

					@if (currentTaskHiveUser != null &&
										!string.IsNullOrEmpty(currentTaskHiveUser.UserTag))
					{
						<small>
							#@currentTaskHiveUser.UserTag
						</small>
					}

				</div>

				<i class="fa-solid fa-chevron-down"></i>

			</button>

			<ul class="dropdown-menu dropdown-menu-end">

				@if (User.IsInRole("Admin"))
				{
					<li>

						<a class="dropdown-item"
						   asp-area="Admin"
						   asp-controller="Dashboard"
						   asp-action="Index">

							Dashboard

						</a>

					</li>
				}
				else
				{
					<li>

						<a class="dropdown-item"
						   asp-area="Member"
						   asp-controller="Profile"
						   asp-action="Index">

							My Profile

						</a>

					</li>
				}

				<li>
					<a class="dropdown-item"
					   asp-area=""
					   asp-controller="Team"
					   asp-action="Index">

						<i class="fa-solid fa-users me-2"></i>
						Takımlarım

					</a>
				</li>

				<li>

					<hr class="dropdown-divider" />

				</li>

				<li>

					<form asp-controller="Account"
						  asp-action="Logout"
						  asp-area=""
						  method="post">

						<button class="dropdown-item">

							Logout

						</button>

					</form>

				</li>

			</ul>

		</div>

	</div>

</nav>