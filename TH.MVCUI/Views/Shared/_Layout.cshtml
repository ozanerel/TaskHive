<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - TaskHive</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/TH.MVCUI.styles.css" asp-append-version="true" />
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Account" asp-action="Login">TaskHive</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						@* <li class="nav-item">
							<a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
						</li> *@
						
					</ul>

					<ul class="navbar-nav ms-auto">
						@if (User.Identity.IsAuthenticated)
						{
							<li class="nav-item">
								<div class="dropdown">
									<button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
										@User.Identity.Name
									</button>
									<ul class="dropdown-menu">
										@* <li>
											<form asp-controller="Profile" asp-action="Index" method="post">
												<button class="dropdown-item">Profile</button>
											</form>


										</li> *@
										<li>
											<form asp-controller="Account" asp-action="Logout" method="post">
												<button class="dropdown-item">Çıkış Yap</button>
											</form>
										</li>
									</ul>
								</div>
							</li>
						}
						else
						{
							<li class="nav-item">
								<a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Giriş Yap</a>
								<a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
							</li>
						}
					</ul>
				</div>
			</div>
		</nav>
	</header>
	<main role="main" class="container pb-3">
		@if (TempData["Error"] != null)
		{
			<div class="alert alert-danger">
				<span>@TempData["Error"]</span>
			</div>
		}
		else if (TempData["Success"] != null)
		{
			<div class="alert alert-success">
				<span>@TempData["Success"]</span>
			</div>
		}

		@RenderBody()
	</main>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2026 - TaskHive - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
