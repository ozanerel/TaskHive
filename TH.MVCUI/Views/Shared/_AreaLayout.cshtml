@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>TaskHive</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />

    <link href="~/css/variables.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/buttons.css" rel="stylesheet" />
    <link href="~/css/forms.css" rel="stylesheet" />
    <link href="~/css/cards.css" rel="stylesheet" />
    <link href="~/css/tables.css" rel="stylesheet" />
    <link href="~/css/sidebar.css" rel="stylesheet" />
    <link href="~/css/navbar.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/project.css" rel="stylesheet" />
    <link href="~/css/task.css" rel="stylesheet" />
    <link href="~/css/user.css" rel="stylesheet" />
    <link href="~/css/role.css" rel="stylesheet" />
    <link href="~/css/notification.css" rel="stylesheet" />
    <link href="~/css/myproject.css" rel="stylesheet" />
    <link href="~/css/mytask.css" rel="stylesheet" />
    <link href="~/css/notification-member.css" rel="stylesheet" />
    <link href="~/css/taskcomment.css" rel="stylesheet" />
    <link href="~/css/profile.css" rel="stylesheet" />
    <link href="~/css/search.css" rel="stylesheet" />

</head>

<body>

    @if (User.IsInRole("Admin"))
    {
        @await Html.PartialAsync("_AdminSidebar")
    }
    else
    {
        @await Html.PartialAsync("_MemberSidebar")
    }

    @await Html.PartialAsync("_Navbar")

    <main class="th-main">

        @RenderBody()

    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>