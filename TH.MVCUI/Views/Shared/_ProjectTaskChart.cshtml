@using System.Text.Json
@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

@{
    var projectNames = Model.ProjectTaskAnalytics
        .Select(x => x.ProjectName)
        .ToList();

    var totalTasks = Model.ProjectTaskAnalytics
        .Select(x => x.TotalTasks)
        .ToList();

    var completedTasks = Model.ProjectTaskAnalytics
        .Select(x => x.CompletedTasks)
        .ToList();

    var projectNamesJson = JsonSerializer.Serialize(projectNames);
    var totalTasksJson = JsonSerializer.Serialize(totalTasks);
    var completedTasksJson = JsonSerializer.Serialize(completedTasks);
}

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Project Task Distribution</h3>
        <span class="text-muted">Project Performance</span>
    </div>

    @if (Model.ProjectTaskAnalytics != null &&
    Model.ProjectTaskAnalytics.Any())
    {
        <div style="position: relative; height: 350px;">
            <canvas id="projectTaskChart"></canvas>
        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-chart-column fa-3x text-secondary mb-3"></i>

            <h5>No project analytics available.</h5>

            <p class="text-muted">
                There are no project task statistics to display.
            </p>

        </div>
    }

</div>

@if (Model.ProjectTaskAnalytics != null &&
    Model.ProjectTaskAnalytics.Any())
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const canvas = document.getElementById("projectTaskChart");

            if (!canvas) {
                return;
            }

            new Chart(canvas, {
                type: "bar",

                data: {
                    labels: @Html.Raw(projectNamesJson),

                    datasets: [
                        {
                            label: "Total Tasks",
                            data: @Html.Raw(totalTasksJson)
                        },
                        {
                            label: "Completed Tasks",
                            data: @Html.Raw(completedTasksJson)
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });

        });
    </script>
}