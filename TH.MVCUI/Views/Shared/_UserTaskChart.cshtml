@using System.Text.Json
@model TH.MVCUI.Areas.Admin.Models.PageVMs.DashboardVm

@{
    var userAnalytics = Model.UserTaskAnalytics ?? new();

    var userNames = userAnalytics
        .Select(x => x.UserName)
        .ToList();

    var completionRates = userAnalytics
        .Select(x => x.CompletionRate)
        .ToList();

    var userNamesJson = JsonSerializer.Serialize(userNames);
    var completionRatesJson = JsonSerializer.Serialize(completionRates);
}

<div class="dashboard-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>User Completion Performance</h3>
        <span class="text-muted">Team Member Performance</span>
    </div>

    @if (userAnalytics.Any())
    {
        <div style="position: relative; height: 350px;">
            <canvas id="userCompletionChart"></canvas>
        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="fa-solid fa-chart-bar fa-3x text-secondary mb-3"></i>

            <h5>No user analytics available.</h5>

            <p class="text-muted">
                There are no user performance statistics to display.
            </p>

        </div>
    }

</div>

@if (userAnalytics.Any())
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const canvas = document.getElementById("userCompletionChart");

            if (!canvas) {
                return;
            }

            new Chart(canvas, {
                type: "bar",

                data: {
                    labels: @Html.Raw(userNamesJson),

                    datasets: [
                        {
                            label: "Completion Rate (%)",
                            data: @Html.Raw(completionRatesJson)
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,

                            ticks: {
                                callback: function (value) {
                                    return value + "%";
                                }
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            position: "bottom"
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return "Completion Rate: "
                                        + context.raw + "%";
                                }
                            }
                        }
                    }
                }
            });

        });
    </script>
}