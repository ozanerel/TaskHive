@model TH.MVCUI.Models.ViewModels.TeamViewModels.TeamCreateViewModel

@{
    ViewData["Title"] = "Yeni Takım";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-2">
                        Yeni Takım Oluştur
                    </h2>

                    <p class="text-muted mb-4">
                        Yeni bir takım oluşturun ve çalışma alanınızı hazırlayın.
                    </p>

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Takım Adı
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Örn. TaskHive Development" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label">
                                Açıklama
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Takımınız hakkında kısa bir açıklama yazın."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Vazgeç

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa-solid fa-plus me-2"></i>
                                Takım Oluştur

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}