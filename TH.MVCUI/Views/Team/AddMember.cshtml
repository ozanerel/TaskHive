@model TH.MVCUI.Models.ViewModels.TeamViewModels.TeamAddMemberViewModel

@{
    ViewData["Title"] = "Takıma Üye Ekle";
    Layout = "~/Views/Shared/_AreaLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Takıma Üye Ekle</h2>

            <p class="text-muted mb-0">
                @Model.TeamName
            </p>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.TeamId"
           class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left me-2"></i>

            Takıma Dön

        </a>

    </div>


    <div class="card">

        <div class="card-body">

            <form asp-action="AddMember"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="TeamId" />

                <div class="mb-3">

                    <label asp-for="UserId"
                           class="form-label">

                        Kullanıcı

                    </label>

                    <select asp-for="UserId"
                            class="form-select">

                        <option value="">
                            Kullanıcı seçiniz
                        </option>

                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">

                                @user.FullName
                                (@user.Email)

                            </option>
                        }

                    </select>

                    <span asp-validation-for="UserId"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <a asp-action="Details"
                       asp-route-id="@Model.TeamId"
                       class="btn btn-secondary">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-user-plus me-2"></i>

                        Üye Ekle

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}